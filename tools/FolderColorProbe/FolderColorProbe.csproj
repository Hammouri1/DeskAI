<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window may cover the Desktop icons the probe reads from the screen. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>DeskAI.FolderColorProbe</RootNamespace>
    <!-- A development probe for ADR 0046. Never referenced by the app or shipped. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DeskAI.FolderColorProbe.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\IconPositionProbe\Geometry.cs" Link="Shared\Geometry.cs" />
    <Compile Include="..\IconPositionProbe\Waiting.cs" Link="Shared\Waiting.cs" />
    <Compile Include="..\IconPositionProbe\DesktopShellView.cs" Link="Shared\DesktopShellView.cs" />
  </ItemGroup>
</Project>
