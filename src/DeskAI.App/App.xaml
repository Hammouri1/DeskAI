<Application
    x:Class="DeskAI.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DeskAI.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Merged after the control resources so DeskAI's palette wins. -->
                <ResourceDictionary Source="ms-appx:///Themes/DeskAITheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StatusLevelToBrushConverter x:Key="StatusLevelToBrush" />
            <converters:StatusLevelToGlyphConverter x:Key="StatusLevelToGlyph" />
            <converters:StatusLevelToBackgroundConverter x:Key="StatusLevelToBackground" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
