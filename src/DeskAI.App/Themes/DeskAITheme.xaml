<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DeskAI visual system: "calm workspace".

        The single rule that keeps this system honest is that the accent colour means
        "safe or confirmed" and is never used as decoration. A person should be able to
        learn one thing - green means DeskAI is allowed to do this - and have it hold on
        every screen. Anything that is merely structure uses the neutral line colour.

        Palettes are declared per theme rather than borrowed from the OS accent, because
        the OS accent is an arbitrary user colour that cannot carry a fixed meaning.
        High contrast falls back to the system brushes so accessibility settings win.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- "Default" is the dark theme in WinUI theme dictionaries. -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DeskGroundBrush" Color="#FF0F1216" />
            <SolidColorBrush x:Key="DeskSurfaceBrush" Color="#FF161B21" />
            <SolidColorBrush x:Key="DeskSurfaceRaisedBrush" Color="#FF1D242C" />
            <SolidColorBrush x:Key="DeskLineBrush" Color="#FF272E38" />
            <SolidColorBrush x:Key="DeskLineStrongBrush" Color="#FF38414D" />

            <SolidColorBrush x:Key="DeskAccentBrush" Color="#FF4DD8A8" />
            <SolidColorBrush x:Key="DeskAccentSoftBrush" Color="#264DD8A8" />
            <SolidColorBrush x:Key="DeskCautionBrush" Color="#FFE8955A" />
            <SolidColorBrush x:Key="DeskCautionSoftBrush" Color="#26E8955A" />
            <SolidColorBrush x:Key="DeskDangerBrush" Color="#FFF0685C" />

            <SolidColorBrush x:Key="DeskTextPrimaryBrush" Color="#FFE7EBF0" />
            <SolidColorBrush x:Key="DeskTextSecondaryBrush" Color="#FF8C97A5" />
            <SolidColorBrush x:Key="DeskTextTertiaryBrush" Color="#FF9DA8B7" />

            <!--
                Hero panels are no longer filled with the accent, so text that used to sit
                on top of the accent is remapped to ordinary text colours. Remapping here
                means every page inherits the fix without per-page edits.
            -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFE7EBF0" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FF8C97A5" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4DD8A8" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64DD8A8" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4DD8A8" />

            <!--
                The accent button style takes its fill from AccentButtonBackground rather
                than from AccentFillColorDefaultBrush, so overriding only the fill colour
                leaves the button on the Windows accent. Both are set here.
            -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF4DD8A8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF6EE0BA" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF3CBF92" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FF272E38" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF4DD8A8" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#FF6EE0BA" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#FF3CBF92" />

            <!-- Dark ink on the light-green accent keeps accent buttons legible. -->
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF08130E" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF08130E" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#DD08130E" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF9DA8B7" />

            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF4DD8A8" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFE8955A" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFF0685C" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF161B21" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF12171C" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF272E38" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE7EBF0" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF8C97A5" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF9DA8B7" />

            <!--
                Soft tints for the stat tiles on Home. Alpha over the surface so they sit on every
                look, and never green: a count is not a permission, and the accent is reserved.
            -->
            <SolidColorBrush x:Key="DeskTintBlueBrush" Color="#2E5B8DEF" />
            <SolidColorBrush x:Key="DeskTintVioletBrush" Color="#2EA07CF0" />
            <SolidColorBrush x:Key="DeskTintAmberBrush" Color="#2EE8B84A" />
            <SolidColorBrush x:Key="DeskTintRoseBrush" Color="#2EEF7C93" />

            <!-- The side menu is painted with the surface, so it reads as one panel in every look. -->
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DeskSurfaceBrush" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DeskSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="DeskSurfaceRaisedBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="DeskLineBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="DeskLineBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DeskGroundBrush" Color="#FFF6F7F9" />
            <SolidColorBrush x:Key="DeskSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DeskSurfaceRaisedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DeskLineBrush" Color="#FFE1E5EA" />
            <SolidColorBrush x:Key="DeskLineStrongBrush" Color="#FFC7CED6" />

            <SolidColorBrush x:Key="DeskAccentBrush" Color="#FF0E8C64" />
            <SolidColorBrush x:Key="DeskAccentSoftBrush" Color="#1A0E8C64" />
            <SolidColorBrush x:Key="DeskCautionBrush" Color="#FFA8541B" />
            <SolidColorBrush x:Key="DeskCautionSoftBrush" Color="#1AA8541B" />
            <SolidColorBrush x:Key="DeskDangerBrush" Color="#FFC0392B" />

            <SolidColorBrush x:Key="DeskTextPrimaryBrush" Color="#FF10161D" />
            <SolidColorBrush x:Key="DeskTextSecondaryBrush" Color="#FF5A6572" />
            <SolidColorBrush x:Key="DeskTextTertiaryBrush" Color="#FF596675" />

            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF10161D" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FF5A6572" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0E8C64" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60E8C64" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0E8C64" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF0E8C64" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF0C7B58" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF0A6A4C" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FFE1E5EA" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF0E8C64" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#FF0C7B58" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#FF0A6A4C" />

            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#DDFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF596675" />

            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF0E8C64" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFA8541B" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFC0392B" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFF0F2F5" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFE1E5EA" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF10161D" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF5A6572" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF596675" />

            <SolidColorBrush x:Key="DeskTintBlueBrush" Color="#3A5B8DEF" />
            <SolidColorBrush x:Key="DeskTintVioletBrush" Color="#3AA07CF0" />
            <SolidColorBrush x:Key="DeskTintAmberBrush" Color="#3AE8B84A" />
            <SolidColorBrush x:Key="DeskTintRoseBrush" Color="#3AEF7C93" />

            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DeskSurfaceBrush" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DeskSurfaceBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="DeskSurfaceRaisedBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="DeskLineBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="DeskLineBrush" />
        </ResourceDictionary>

        <!-- High contrast defers entirely to the user's Windows settings. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DeskGroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DeskSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DeskSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DeskLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DeskLineStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DeskAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DeskAccentSoftBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DeskCautionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DeskCautionSoftBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DeskDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DeskTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DeskTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DeskTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DeskTintBlueBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DeskTintVioletBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DeskTintAmberBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DeskTintRoseBrush" Color="Transparent" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--
        Retired decoration. Kept as a transparent brush so pages that still reference the
        old gradient wash render nothing instead of failing to load.
    -->
    <SolidColorBrush x:Key="HeroSheenBrush" Color="Transparent" />

    <!--
        A readout, not a banner. The 3px left rail is the state indicator, and the corner
        is square on the rail edge so the rail reads as an edge marker, not a pill.
    -->
    <Style x:Key="HeroPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DeskSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskAccentBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="0,14,14,0" />
        <Setter Property="Padding" Value="26,22" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DeskSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="SoftCardStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="RowCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DeskSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- A quiet chip, not an accent dot. The accent is reserved for safety state. -->
    <Style x:Key="StepBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource DeskSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DeskDisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextPrimaryBrush}" />
    </Style>

    <!-- Metrics are set large and light so the number reads before its label. -->
    <Style x:Key="MetricStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodySecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextTertiaryBrush}" />
    </Style>

    <!--
        A stat tile: one icon, one big number, one caption, on a soft tint. The tint is never
        the accent, because a count is not a permission. Text stays the ordinary text colour.
    -->
    <Style x:Key="TileStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="MinHeight" Value="118" />
    </Style>

    <Style x:Key="TileIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--
        A pill: a small rounded chip with an icon and a word. Neutral by default. The accent
        variant is only for a permission or a confirmed state; caution for "paused" or "needs
        a look". Every pill carries an icon and a word, so colour never stands alone.
    -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DeskSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentPillStyle" TargetType="Border" BasedOn="{StaticResource PillStyle}">
        <Setter Property="Background" Value="{ThemeResource DeskAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskAccentBrush}" />
    </Style>

    <Style x:Key="CautionPillStyle" TargetType="Border" BasedOn="{StaticResource PillStyle}">
        <Setter Property="Background" Value="{ThemeResource DeskCautionSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskCautionBrush}" />
    </Style>

    <Style x:Key="PillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextPrimaryBrush}" />
    </Style>

    <!-- The small grey label above a group of menu items, and above a group of cards. -->
    <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextTertiaryBrush}" />
    </Style>

    <!-- A page's top bar: the page name and the tools that are the same on every page. -->
    <Style x:Key="TopBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DeskSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="28,14" />
    </Style>


    <!-- Shared spacing and native controls; templates/focus/high-contrast behavior stay WinUI's. -->
    <Style x:Key="PageContentStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="32,28,32,40" />
        <Setter Property="MaxWidth" Value="1120" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Spacing" Value="24" />
    </Style>
    <Style x:Key="PageIntroStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DeskTintBlueBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="28,24" />
    </Style>
    <Style x:Key="SectionTabsStyle" TargetType="Pivot">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="-12,0,-12,0" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <!--
        The "?" button. Neutral on purpose: asking what something is confirms nothing, so it
        must not wear the accent that means "safe". Small and round so it reads as a hint
        attached to a title rather than a control that does something.
    -->
    <Style x:Key="HelpButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeskLineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource DeskTextSecondaryBrush}" />
    </Style>

    <!--
        The pop-up. Three labelled parts, always in the same order, so after reading one a
        person knows where to look in every other. Only the last part carries the accent and
        the same left rail the status readouts use, because it is the one line that is a
        safety promise, and it is what a cautious person is actually looking for.
    -->
    <DataTemplate x:Key="HelpTopicTemplate">
        <StackPanel MaxWidth="320" Spacing="12">
            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource DeskTextPrimaryBrush}"
                       Text="{Binding Title}" />
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource CaptionStyle}" Text="What it is" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Foreground="{ThemeResource DeskTextPrimaryBrush}"
                           Text="{Binding WhatItIs}" />
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource CaptionStyle}" Text="What it does" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Foreground="{ThemeResource DeskTextPrimaryBrush}"
                           Text="{Binding WhatItDoes}" />
            </StackPanel>
            <Border Padding="12,9" CornerRadius="0,4,4,0" BorderThickness="3,0,0,0"
                    Background="{ThemeResource DeskAccentSoftBrush}"
                    BorderBrush="{ThemeResource DeskAccentBrush}">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE72E;"
                                  Foreground="{ThemeResource DeskAccentBrush}" />
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DeskAccentBrush}"
                                   Text="What it never does" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                               Text="{Binding WhatItNeverDoes}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
