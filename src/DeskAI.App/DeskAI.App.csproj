<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>DeskAI.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DeskAI.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <!-- Explicit developer-only build. It never replaces the normal application output. -->
  <PropertyGroup Condition="'$(DeskAiUiPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);DESKAI_UI_PREVIEW</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\ui-preview\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(DeskAiUiPreview)' == 'true'">
    <Compile Include="..\..\tools\UiPreview.cs" Link="Development\UiPreview.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\DeskAI.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\DeskAI.Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\DeskAI.Core\DeskAI.Core.csproj" />
    <ProjectReference Include="..\DeskAI.Safety\DeskAI.Safety.csproj" />
    <ProjectReference Include="..\DeskAI.Infrastructure\DeskAI.Infrastructure.csproj" />
    <ProjectReference Include="..\DeskAI.AI\DeskAI.AI.csproj" />
    <ProjectReference Include="..\DeskAI.Presentation\DeskAI.Presentation.csproj" />
    <ProjectReference Include="..\DeskAI.PdfWorker\DeskAI.PdfWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <Target Name="CopyPdfWorker" AfterTargets="Build">
    <ItemGroup>
      <PdfWorkerFile Include="..\DeskAI.PdfWorker\bin\$(Configuration)\net10.0\win-x64\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfWorkerFile)" DestinationFolder="$(OutDir)PdfWorker\" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishPdfWorker" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\DeskAI.PdfWorker\DeskAI.PdfWorker.csproj&quot; -c $(Configuration) -r win-x64 --self-contained --no-restore -p:PublishSingleFile=true -o &quot;$(PublishDir)PdfWorker&quot;" />
  </Target>
  <!--
    Windows App SDK issue #6720: the unpackaged .NET 10 publish path can omit the app PRI and
    compiled XAML even though it generated them in TargetDir. Without them, the process starts
    but WinUI cannot create a visible interface. Keep this additive workaround until the pinned
    SDK publishes these resources itself; SkipUnchangedFiles makes duplicate future copies inert.
  -->
  <Target Name="CopyUnpackagedWinUiResources" AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <UnpackagedWinUiResource Include="$(TargetDir)**\*.xbf" />
      <UnpackagedWinUiResource Include="$(ProjectPriFullPath)"
                               Condition="Exists('$(ProjectPriFullPath)')" />
    </ItemGroup>
    <Error Condition="!Exists('$(ProjectPriFullPath)')"
           Text="The WinUI project resource index was not generated; refusing to publish an app with no interface." />
    <Copy SourceFiles="@(UnpackagedWinUiResource)"
          DestinationFiles="@(UnpackagedWinUiResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
