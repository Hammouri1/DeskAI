<Page
    x:Class="DeskAI.App.Views.OrganizePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:DeskAI.App.ViewModels"
    xmlns:controls="using:DeskAI.App.Controls"
    Background="{ThemeResource DeskGroundBrush}">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,44" MaxWidth="880" HorizontalAlignment="Left" Spacing="22">

            <!-- One job, said once: what this page is for and the promise that goes with it. -->
            <StackPanel Spacing="6" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Tidy a folder" />
                    <controls:HelpButton Topic="organize.tidy" />
                </StackPanel>
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Text="Pick a folder. DeskAI suggests where things go. Nothing moves until you say so." />
            </StackPanel>

            <!-- Which folder. The list holds folders already connected; the button adds one. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <ComboBox HorizontalAlignment="Stretch"
                                  PlaceholderText="Pick a folder"
                                  AutomationProperties.Name="Folder to tidy"
                                  Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.Folders}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Choose another folder"
                                Click="OnChooseFolderClick" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <HyperlinkButton Padding="0" Content="Stop tidying this folder"
                                         Visibility="{x:Bind ViewModel.CanStopTidying, Mode=OneWay}"
                                         Command="{x:Bind ViewModel.StopTidyingCommand}" />
                        <HyperlinkButton Padding="0" Content="Look again"
                                         Visibility="{x:Bind ViewModel.CanStopTidying, Mode=OneWay}"
                                         Command="{x:Bind ViewModel.RefreshCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                               Text="{x:Bind ViewModel.Message, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Nothing connected yet: one clear thing to do. -->
            <Border Style="{StaticResource SoftCardStyle}" Visibility="{x:Bind ViewModel.HasNoFolders, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                               Text="Pick a folder to tidy" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Downloads and Desktop are good places to start. DeskAI looks first and shows you everything before anything moves." />
                    <Button HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"
                            Content="Choose a folder" Click="OnChooseFolderClick" />
                </StackPanel>
            </Border>

            <!--
                The permission. It wears the green rail because every line in it is a promise
                about what DeskAI will not do, and green means "safe" everywhere in this app.
            -->
            <Border Style="{StaticResource HeroPanelStyle}" Visibility="{x:Bind ViewModel.NeedsPermission, Mode=OneWay}">
                <StackPanel Spacing="14" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{x:Bind ViewModel.PermissionTitle, Mode=OneWay}" />
                        <controls:HelpButton Topic="organize.permission" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="13" Glyph="&#xE8B7;" Foreground="{ThemeResource DeskAccentBrush}" />
                            <TextBlock Style="{StaticResource BodySecondaryStyle}" Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                       Text="It moves loose files into folders inside this folder." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="13" Glyph="&#xE72E;" Foreground="{ThemeResource DeskAccentBrush}" />
                            <TextBlock Style="{StaticResource BodySecondaryStyle}" Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                       Text="It never deletes anything and never touches files in subfolders." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="13" Glyph="&#xE73E;" Foreground="{ThemeResource DeskAccentBrush}" />
                            <TextBlock Style="{StaticResource BodySecondaryStyle}" Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                       Text="Nothing moves until you press Tidy." />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"
                            Content="Allow tidying" Click="OnAllowTidyClick" />
                </StackPanel>
            </Border>

            <!-- What would happen, grouped by where things would go. -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSuggestions, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   Text="{x:Bind ViewModel.SuggestionsFromText, Mode=OneWay}" />
                        <controls:HelpButton Topic="organize.suggestions" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Foreground="{ThemeResource DeskCautionBrush}"
                               Visibility="{x:Bind ViewModel.HasLimitNote, Mode=OneWay}"
                               Text="{x:Bind ViewModel.LimitNote, Mode=OneWay}" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" AutomationProperties.Name="Suggested folders">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TidyGroupViewModel">
                            <Border Style="{StaticResource RowCardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                                        <CheckBox IsThreeState="True" MinWidth="0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{x:Bind DisplayName}"
                                                  IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />
                                        <FontIcon Grid.Column="1" FontSize="16" Glyph="{x:Bind Glyph}"
                                                  Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                   Text="{x:Bind DisplayName}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Text="{x:Bind CountText}" />
                                    </Grid>
                                    <!-- Only the "AI isn't sure" group has a note: its files wait to be ticked. -->
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               Foreground="{ThemeResource DeskCautionBrush}"
                                               Visibility="{x:Bind HasNote}"
                                               Text="{x:Bind Note}" />
                                    <Expander Header="Show files" HorizontalAlignment="Stretch">
                                        <ItemsControl ItemsSource="{x:Bind Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:TidyItemViewModel">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,10">
                                                        <CheckBox MinWidth="0" VerticalAlignment="Top"
                                                                  AutomationProperties.Name="{x:Bind FileName}"
                                                                  IsEnabled="{x:Bind CanBeIncluded}"
                                                                  IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                                       Text="{x:Bind FileName}" />
                                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Reason}" />
                                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Destination}" />
                                                            <StackPanel Spacing="2" Visibility="{x:Bind HasSameName}">
                                                                <TextBlock Style="{StaticResource CaptionStyle}"
                                                                           Foreground="{ThemeResource DeskCautionBrush}"
                                                                           Text="{x:Bind SameNameMessage}" />
                                                                <ToggleSwitch OffContent="Skip this file"
                                                                              OnContent="Keep both (adds a number)"
                                                                              AutomationProperties.Name="Keep both files"
                                                                              IsOn="{x:Bind KeepBoth, Mode=TwoWay}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--
                Asking AI. Nothing here sends anything: the button opens a dialog showing exactly
                what the AI would see, and only Send in that dialog sends it. The button is a
                plain one, because pressing it confirms nothing; the answer appears right below.
            -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasAiPanel, Mode=OneWay}">
                <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="16" Glyph="&#xE945;" Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Ask AI" />
                        <controls:HelpButton Topic="organize.askAi" />
                    </StackPanel>
                    <RadioButtons Header="Which files may AI suggest a place for?"
                                  SelectedIndex="{x:Bind ViewModel.SuggestionModeIndex, Mode=TwoWay}">
                        <RadioButton Content="Only files DeskAI doesn't know" />
                        <RadioButton Content="Every file my rules don't place"
                                     IsEnabled="{x:Bind ViewModel.CanUseAiForEveryFile, Mode=OneWay}" />
                    </RadioButtons>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                               Text="{x:Bind ViewModel.AskAiPrompt, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12"
                                Visibility="{x:Bind ViewModel.HasAskable, Mode=OneWay}">
                        <Button Content="{x:Bind ViewModel.AskAiText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanAskAi, Mode=OneWay}"
                                Click="OnAskAiClick" />
                        <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsAskingAi, Mode=OneWay}" />
                        <Button Content="Stop" Command="{x:Bind ViewModel.StopAiCommand}"
                                Visibility="{x:Bind ViewModel.IsAskingAi, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="{x:Bind ViewModel.AiSharingNote, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                               Visibility="{x:Bind ViewModel.HasAiMessage, Mode=OneWay}"
                               Text="{x:Bind ViewModel.AiMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- What DeskAI will not touch, and why. Listed rather than silently dropped. -->
            <Expander HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.HasLeftAlone, Mode=OneWay}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.LeftAloneTitle, Mode=OneWay}" />
                        <controls:HelpButton Topic="organize.leftAlone" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{x:Bind ViewModel.LeftAlone}" AutomationProperties.Name="Files left alone">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TidyLeftAloneViewModel">
                            <StackPanel Spacing="2" Margin="0,0,0,10">
                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                           Text="{x:Bind FileName}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Reason}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!--
                The one bold element: how many files are ready, the button, and the honest line
                under it. In this version the button is off, and the line says so plainly.
            -->
            <Border Style="{StaticResource CardStyle}" Padding="22,18"
                    Visibility="{x:Bind ViewModel.HasSuggestions, Mode=OneWay}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                    <TextBlock Style="{StaticResource MetricStyle}" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.IncludedCount, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                   Text="files ticked" />
                        <TextBlock Style="{StaticResource CaptionStyle}" MaxWidth="420" HorizontalAlignment="Left"
                                   Text="{x:Bind ViewModel.TidyNote}" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" MinWidth="150"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{x:Bind ViewModel.TidyButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanPressTidy}" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <HyperlinkButton Padding="0" Content="Nervous? Try it on example files first"
                                 Click="OnPracticeClick" />
                <controls:HelpButton Topic="organize.practice" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
