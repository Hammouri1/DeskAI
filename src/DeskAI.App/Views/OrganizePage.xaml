<Page
    x:Class="DeskAI.App.Views.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource DeskGroundBrush}">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,40" MaxWidth="980" HorizontalAlignment="Left" Spacing="24">

            <Border Style="{StaticResource HeroPanelStyle}">
                <Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE72E;"
                                          Foreground="{ThemeResource DeskAccentBrush}" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Practice mode"
                                           Foreground="{ThemeResource DeskAccentBrush}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource DeskDisplayStyle}"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       Text="Try organizing sample files" />
                            <TextBlock MaxWidth="560" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                       Text="Everything below uses files DeskAI made up for practice. None of your own files are opened or changed." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource StepBadgeStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Text="1"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Review" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="See the suggested moves" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource StepBadgeStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Text="2"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Choose" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Untick anything you don't want" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource StepBadgeStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Text="3"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Try it" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Run it on sample files" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Suggested moves" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding ReadySummary}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom"
                        Command="{Binding SelectAllSafeCommand}" Content="Select all" />
                <Button Grid.Column="2" VerticalAlignment="Bottom"
                        Command="{Binding ClearSelectionCommand}" Content="Clear" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Operations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCardStyle}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                <CheckBox VerticalAlignment="Center"
                                          AutomationProperties.Name="Include this sample file"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsSelectable}" />
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <FontIcon FontSize="17" Glyph="{Binding FileGlyph}"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding FromFolder}" />
                                        <FontIcon FontSize="11" Glyph="&#xE72A;" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ToFolder}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding FileType}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Width="200" VerticalAlignment="Center" Spacing="6">
                                    <!--
                                        Colour is never alone here: the badge always carries an icon
                                        and the status word, so a blocked row still reads as blocked.
                                    -->
                                    <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="12"
                                            Background="{Binding StatusLevel, Converter={StaticResource StatusLevelToBackground}}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="12" VerticalAlignment="Center"
                                                      Glyph="{Binding StatusLevel, Converter={StaticResource StatusLevelToGlyph}}"
                                                      Foreground="{Binding StatusLevel, Converter={StaticResource StatusLevelToBrush}}" />
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding StatusDetail}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Ready to try it?" />
                        <TextBlock MaxWidth="570" Style="{StaticResource BodySecondaryStyle}"
                                   Text="{Binding ResultMessage}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <ProgressRing Width="24" Height="24" HorizontalAlignment="Center" IsActive="{Binding IsBusy}" />
                        <Button AutomationProperties.HelpText="Organizes only generated sample files."
                                Command="{Binding ExecuteDemoCommand}" Content="{Binding ExecuteButtonText}"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button AutomationProperties.HelpText="Returns unchanged sample files to their original demo locations."
                                Command="{Binding UndoDemoCommand}" Content="{Binding UndoButtonText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Needs attention" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding AttentionSummary}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowCardStyle}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <FontIcon VerticalAlignment="Top" FontSize="17"
                                              Glyph="{Binding Level, Converter={StaticResource StatusLevelToGlyph}}"
                                              Foreground="{Binding Level, Converter={StaticResource StatusLevelToBrush}}" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding Explanation}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="3">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Severity}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding AffectedItems}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding UnchangedSummary}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <FontIcon FontSize="20" VerticalAlignment="Top" Glyph="&#xE753;"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Want a second opinion?" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding AiDisclosureSummary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <ProgressRing Width="22" Height="22" IsActive="{Binding IsAiBusy}" />
                            <Button Command="{Binding GetAiSuggestionsCommand}" Content="Get AI ideas" />
                            <Button Command="{Binding CancelAiCommand}" Content="Stop" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding AiPreviewMessage}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding AiUsageSummary}" />
                    <ItemsControl ItemsSource="{Binding AiSuggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SoftCardStyle}" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Reason}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Category}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Text="{Binding Confidence}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="{Binding Provider}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Padding="12" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="14" VerticalAlignment="Center" Glyph="&#xE72E;"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                       Text="These are ideas only. AI cannot move, rename, or change any file." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <FontIcon FontSize="18" VerticalAlignment="Top" Glyph="&#xE81C;"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Recent activity" />
                        <TextBlock Text="{Binding ActivityTitle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding ActivityMessage}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Expander HorizontalAlignment="Stretch" Header="More details">
                <StackPanel Padding="12" Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="Temporary demo location" />
                    <TextBlock Text="{Binding DemoRoot}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RevisionLabel}" />
                    <TextBlock Text="{Binding SupportingFolderSummary}" />
                    <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                            AutomationProperties.Name="Create a fresh plan revision"
                            Command="{Binding RebuildPreviewCommand}" Content="Refresh suggestions" />
                </StackPanel>
            </Expander>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <FontIcon FontSize="20" VerticalAlignment="Top" Glyph="&#xE8DA;"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Preview one of your own folders" />
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Optional and read-only. DeskAI lists file names, sizes, and dates. It cannot move, rename, delete, or open what is inside." />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnChooseFolderClick" Content="Choose a folder" Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{Binding RevokeFolderCommand}" Content="Disconnect" />
                        <ProgressRing Width="22" Height="22" VerticalAlignment="Center" IsActive="{Binding IsFolderBusy}" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding FolderPreviewTitle}" />
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding FolderPreviewMessage}" />
                    </StackPanel>
                    <Expander HorizontalAlignment="Stretch" Header="{Binding FolderFileCount}">
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding FolderFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,8" ColumnDefinitions="2*,*,Auto" ColumnSpacing="12">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Folder}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Modified}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Size}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
