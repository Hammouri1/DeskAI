<Page
    x:Class="DeskAI.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32" MaxWidth="760" HorizontalAlignment="Left" Spacing="18">
            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Privacy and AI" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="You choose if AI is used and what it is allowed to see." />
            </StackPanel>

            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="At a glance" />
                    <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                        <TextBlock Grid.Row="0" Text="Internet" />
                        <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="{Binding InternetUse}" />
                        <TextBlock Grid.Row="1" Text="AI" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding AiProcessing}" />
                        <TextBlock Grid.Row="2" Text="Shared with online AI" />
                        <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding CloudDataShared}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="Folders you connected" />
                        <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Text="{Binding AuthorizedFolderCount}" />
                        <TextBlock Grid.Row="4" Text="Usage tracking" />
                        <TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Text="Off" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="What online AI may see" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Nothing is sent unless you turn on online AI. Private and protected files are always left out." />
                    </StackPanel>
                    <ToggleSwitch Header="File type (.pdf, .jpg, and similar)" OffContent="No" OnContent="Yes" IsOn="{Binding ShareExtension, Mode=TwoWay}" />
                    <ToggleSwitch Header="File size and last changed date" OffContent="No" OnContent="Yes" IsOn="{Binding ShareMetadata, Mode=TwoWay}" />
                    <ToggleSwitch Header="File name" OffContent="No" OnContent="Yes" IsOn="{Binding ShareFileName, Mode=TwoWay}" />
                    <ToggleSwitch Header="Folder names" OffContent="No" OnContent="Yes" IsOn="{Binding ShareFolderNames, Mode=TwoWay}" />
                    <ToggleSwitch Header="Full location on your computer (best left off)" OffContent="No" OnContent="Yes" IsOn="{Binding ShareFullPath, Mode=TwoWay}" />
                    <ToggleSwitch Header="Text inside files — not available" IsEnabled="False" IsOn="False" />
                    <ToggleSwitch Header="Images inside files — not available" IsEnabled="False" IsOn="False" />
                    <Button HorizontalAlignment="Left" Click="OnSavePrivacyClick" Content="Save these choices"
                            Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SaveStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Choose how AI works" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="AI is optional. If one choice fails, DeskAI will not quietly send your information somewhere else." />
                    </StackPanel>
                    <ComboBox Header="How should DeskAI work?" SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Don't use AI" />
                        <ComboBoxItem Content="AI running on this computer" />
                        <ComboBoxItem Content="Online AI through OpenRouter" />
                    </ComboBox>
                    <Expander Header="More options">
                        <StackPanel Padding="0,10,0,0" Spacing="10">
                            <NumberBox Header="Stop waiting after this many seconds" Minimum="5" Maximum="120"
                                       SpinButtonPlacementMode="Compact" Value="{Binding TimeoutSeconds, Mode=TwoWay}" />
                            <NumberBox Header="Most online AI requests allowed each day" Minimum="1" Maximum="1000"
                                       SpinButtonPlacementMode="Compact" Value="{Binding DailyRequestLimit, Mode=TwoWay}" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="DeskAI does not retry by itself. Check OpenRouter to see prices and spending." />
                        </StackPanel>
                    </Expander>
                    <Expander Header="AI on this computer">
                        <StackPanel Padding="0,10,0,0" Spacing="10">
                            <TextBox Header="Local AI address" PlaceholderText="http://127.0.0.1:11434/v1/chat/completions"
                                     Text="{Binding LocalEndpoint, Mode=TwoWay}" />
                            <TextBox Header="Model name" PlaceholderText="Enter the model shown by your local AI app"
                                     Text="{Binding LocalModel, Mode=TwoWay}" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Online AI with OpenRouter">
                        <StackPanel Padding="0,10,0,0" Spacing="10">
                            <TextBox Header="Model name from OpenRouter" PlaceholderText="For example: provider/model-name"
                                     Text="{Binding OpenRouterModel, Mode=TwoWay}" />
                            <PasswordBox x:Name="OpenRouterKeyBox" Header="Your OpenRouter key" PasswordRevealMode="Peek"
                                         PlaceholderText="Saved securely by Windows" />
                            <ToggleSwitch Header="I agree to send only my choices above to OpenRouter"
                                          IsOn="{Binding CloudConsent, Mode=TwoWay}" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="OpenRouter controls prices and how its service handles data. DeskAI sends no file contents in this version." />
                            <Button HorizontalAlignment="Left" Click="OnRemoveOpenRouterKeyClick" Content="Remove saved OpenRouter key" />
                        </StackPanel>
                    </Expander>
                    <Button HorizontalAlignment="Left" Click="OnSaveProviderClick" Content="Save AI choice"
                            Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ProviderStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
