<Page
    x:Class="DeskAI.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="32" Spacing="12">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Privacy status" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="AI processing" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Rule Engine Only" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cloud data shared" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="None" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Authorized folders" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="0" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Telemetry" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Off" />
        </Grid>
        <TextBlock Margin="0,16,0,0" MaxWidth="680" HorizontalAlignment="Left" TextWrapping="Wrap"
                   Text="Provider setup, disclosure controls, and folder authorization will be added only in their roadmap milestones." />
    </StackPanel>
</Page>
