<Page
    x:Class="DeskAI.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskAI.App.Controls"
    Background="{ThemeResource DeskGroundBrush}">
    <ScrollViewer>
        <StackPanel Margin="28,24,28,40" MaxWidth="920" HorizontalAlignment="Left" Spacing="22">

            <!--
                The hero states the facts a person most wants from a privacy page as five small
                readouts, so nothing has to be scrolled to. Each is a value from the saved settings,
                never a fixed reassurance; "Usage tracking" is the one fixed word, because DeskAI
                has no telemetry at all.
            -->
            <Border Style="{StaticResource HeroPanelStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource DeskDisplayStyle}"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   Text="Privacy and AI" />
                        <TextBlock MaxWidth="560" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                   Text="You decide whether AI is used at all, which service it uses, and exactly what it is allowed to see." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10" AutomationProperties.Name="At a glance">
                        <Border Style="{StaticResource SoftCardStyle}" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="Internet" />
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding InternetUse}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SoftCardStyle}" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="AI" />
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding AiProcessing}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SoftCardStyle}" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="Shared with online AI" />
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CloudDataShared}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource SoftCardStyle}" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="Folders you connected" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding AuthorizedFolderCount}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource SoftCardStyle}" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="Usage tracking" />
                                <TextBlock FontWeight="SemiBold" Text="Off" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="What online AI may see" />
                            <controls:HelpButton Topic="settings.sharing" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   Text="Nothing is sent unless you turn on online AI. Private and protected files are always left out." />
                    </StackPanel>
                    <ToggleSwitch Header="File type (.pdf, .jpg, and similar)" OffContent="No" OnContent="Yes" IsOn="{Binding ShareExtension, Mode=TwoWay}" />
                    <ToggleSwitch Header="File size and last changed date" OffContent="No" OnContent="Yes" IsOn="{Binding ShareMetadata, Mode=TwoWay}" />
                    <ToggleSwitch Header="File name" OffContent="No" OnContent="Yes" IsOn="{Binding ShareFileName, Mode=TwoWay}" />
                    <ToggleSwitch Header="Folder names" OffContent="No" OnContent="Yes" IsOn="{Binding ShareFolderNames, Mode=TwoWay}" />
                    <ToggleSwitch Header="Full location on your computer (best left off)" OffContent="No" OnContent="Yes" IsOn="{Binding ShareFullPath, Mode=TwoWay}" />
                    <ToggleSwitch Header="Text inside files — not available" IsEnabled="False" IsOn="False" />
                    <ToggleSwitch Header="Images inside files — not available" IsEnabled="False" IsOn="False" />
                    <Button HorizontalAlignment="Left" Click="OnSavePrivacyClick" Content="Save these choices"
                            Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding SaveStatus}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Choose how AI works" />
                            <controls:HelpButton Topic="settings.aiChoice" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   Text="AI is optional. If one choice fails, DeskAI will not quietly send your information somewhere else." />
                    </StackPanel>
                    <ComboBox Header="How should DeskAI work?" HorizontalAlignment="Stretch"
                              SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Don't use AI" />
                        <ComboBoxItem Content="AI running on this computer" />
                        <ComboBoxItem Content="Online AI with my own key" />
                    </ComboBox>

                    <Expander HorizontalAlignment="Stretch" Header="AI on this computer">
                        <StackPanel Padding="0,10,0,0" Spacing="10">
                            <TextBox Header="Local AI address" PlaceholderText="http://127.0.0.1:11434/v1/chat/completions"
                                     Text="{Binding LocalEndpoint, Mode=TwoWay}" />
                            <TextBox Header="Model name" PlaceholderText="Enter the model shown by your local AI app"
                                     Text="{Binding LocalModel, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="Only an address on this computer is accepted. DeskAI does not install or start the AI app for you." />
                        </StackPanel>
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" Header="Online AI with your own key">
                        <StackPanel Padding="0,10,0,0" Spacing="10">
                            <ComboBox Header="Which AI service is your key for?" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding CloudProviderNames}"
                                      SelectedIndex="{Binding SelectedCloudProviderIndex, Mode=TwoWay}" />
                            <TextBox Header="Model name" Text="{Binding CloudModel, Mode=TwoWay}"
                                     PlaceholderText="{Binding CloudModelHint}" />
                            <PasswordBox x:Name="CloudKeyBox" PasswordRevealMode="Peek"
                                         Header="{Binding CloudKeyHeader}"
                                         PlaceholderText="Saved securely by Windows" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding CloudKeySourceHint}" />
                            <ToggleSwitch Header="{Binding CloudConsentHeader}" IsOn="{Binding CloudConsent, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding CloudProviderNote}" />
                            <Button HorizontalAlignment="Left" Click="OnRemoveCloudKeyClick" Content="{Binding RemoveKeyLabel}" />
                        </StackPanel>
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" Header="More options">
                        <StackPanel Padding="0,10,0,0" Spacing="10">
                            <NumberBox Header="Stop waiting after this many seconds" Minimum="5" Maximum="120"
                                       SpinButtonPlacementMode="Compact" Value="{Binding TimeoutSeconds, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox Header="Most online AI requests allowed each day" Minimum="1" Maximum="1000"
                                           SpinButtonPlacementMode="Compact" Value="{Binding DailyRequestLimit, Mode=TwoWay}" />
                                <controls:HelpButton VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                     Topic="settings.dailyLimit" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="DeskAI does not retry by itself. Check your AI service to see prices and spending." />
                        </StackPanel>
                    </Expander>

                    <Button HorizontalAlignment="Left" Click="OnSaveProviderClick" Content="Save AI choice"
                            Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" Text="{Binding ProviderStatus}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <FontIcon FontSize="18" VerticalAlignment="Top" Glyph="&#xE72E;"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Where your key is kept" />
                            <controls:HelpButton Topic="settings.key" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   Text="Windows stores it, not DeskAI. Each service has its own separate entry, so a key you save for one company is never sent to another. DeskAI never shows a key again after you save it." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
