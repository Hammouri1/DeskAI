<Page
    x:Class="DeskAI.App.Views.AutomationPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:DeskAI.App.ViewModels"
    xmlns:controls="using:DeskAI.App.Controls"
    Background="{ThemeResource DeskGroundBrush}">
    <ScrollViewer>
        <Grid Margin="28,24,28,40" MaxWidth="1240" HorizontalAlignment="Left" RowDefinitions="Auto,Auto" RowSpacing="22">

            <!--
                Two columns when the window is wide: the rules on the left, "Checking for you" on
                the right where it is never scrolled past (ADR 0017). One column below 1100px, with
                the checking card first for the same reason.
            -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="Columns.ColumnDefinitions" Value="*" />
                            <Setter Target="Columns.RowDefinitions" Value="Auto,Auto" />
                            <Setter Target="RightColumn.(Grid.Column)" Value="0" />
                            <Setter Target="RightColumn.(Grid.Row)" Value="0" />
                            <Setter Target="LeftColumn.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Automatic tasks" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="640"
                           HorizontalAlignment="Left"
                           Text="Write down a tidy-up you repeat, then try it as a practice run to see exactly what it would do." />
            </StackPanel>

            <!--
                Said plainly and first. A rules page is exactly where someone would assume
                things happen on their own, so the page answers that before anything else.

                The wording changed when automatic checks arrived. It used to say nothing ran
                on its own, which stopped being true: DeskAI now looks by itself. What it
                still cannot do is move anything, and that is the promise worth making
                precisely rather than the comfortable one worth keeping.
            -->
            <Border Style="{StaticResource SoftCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{ThemeResource DeskAccentBrush}" />
                        <TextBlock FontWeight="SemiBold" FontSize="13"
                                   Foreground="{ThemeResource DeskAccentBrush}"
                                   Text="DeskAI never moves a file on its own" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="DeskAI can look at your connected folders for you and tell you when your rules match something. Looking is all it does: it cannot move, rename, or delete anything from this page. Anything real still goes through the preview where you approve it first." />
                </StackPanel>
            </Border>
            </StackPanel>

            <Grid x:Name="Columns" Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="22" RowSpacing="22">

            <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="22">
            <!--
                The automatic-check controls. Deliberately in their own column beside the rules
                rather than at the bottom: how often DeskAI looks at someone's folders is a bigger
                decision than any individual rule, and it should not be something they scroll
                past. See ADR 0017. The pills say the state in a word: caution for paused.
            -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Checking for you" />
                            <controls:HelpButton Topic="automation.checking" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource CautionPillStyle}" Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="11" Glyph="&#xE769;" Foreground="{ThemeResource DeskCautionBrush}" />
                                    <TextBlock Style="{StaticResource PillTextStyle}" Text="Paused" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PillStyle}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="11" Glyph="&#xE823;" Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource PillTextStyle}" Text="{x:Bind ViewModel.SelectedFrequency.Label, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   Text="{x:Bind ViewModel.AutomaticCheckSummary, Mode=OneWay}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                        <ComboBox Header="How often"
                                  MinWidth="200"
                                  ItemsSource="{x:Bind ViewModel.FrequencyOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFrequency, Mode=TwoWay}"
                                  AutomationProperties.Name="How often DeskAI checks" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom"
                                Content="Check now"
                                Command="{x:Bind ViewModel.CheckNowCommand}" />
                        <controls:HelpButton Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                             HorizontalAlignment="Left"
                                             Topic="automation.frequency" />
                    </Grid>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="{x:Bind ViewModel.LastCheckedDescription, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleSwitch Header="Pause all automatic checks"
                                      OnContent="Paused" OffContent="Running"
                                      IsOn="{x:Bind ViewModel.IsPaused, Mode=TwoWay}"
                                      AutomationProperties.Name="Pause all automatic checks" />
                        <controls:HelpButton VerticalAlignment="Top" Topic="automation.pause" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ToggleSwitch Header="Tell me with a Windows notification"
                                          OnContent="On" OffContent="Off"
                                          IsOn="{x:Bind ViewModel.NotifyWhenSomethingIsFound, Mode=TwoWay}"
                                          AutomationProperties.Name="Show a Windows notification when something is found" />
                            <controls:HelpButton VerticalAlignment="Top" Topic="automation.notifications" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionStyle}" MaxWidth="560"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   Text="Off unless you turn it on. With it off, DeskAI shows a quiet message inside the app instead." />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CanKeepRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ToggleSwitch x:Name="KeepRunningSwitch"
                                          Header="Keep checking after I close the window"
                                          OnContent="On" OffContent="Off"
                                          IsOn="{x:Bind ViewModel.KeepsRunningWhenClosed, Mode=OneWay}"
                                          Toggled="OnKeepRunningToggled"
                                          AutomationProperties.Name="Keep checking after I close the window" />
                            <controls:HelpButton VerticalAlignment="Top" Topic="automation.keeprunning" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionStyle}" MaxWidth="560"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   Text="Off unless you turn it on. DeskAI will ask you first, and will never add itself to Windows startup." />
                    </StackPanel>

                    <Expander Header="More details" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="600"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   Text="{x:Bind ViewModel.MoreDetails, Mode=OneWay}" />
                    </Expander>

                    <!--
                        Automatic behaviour someone cannot look back at is behaviour they
                        have to take on trust. Interrupted and failed checks are listed too;
                        a history that omitted them would be reassuring rather than accurate.
                    -->
                    <Expander Header="Recent checks" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Visibility="{x:Bind ViewModel.HasRecentChecks, Mode=OneWay}"
                                       Text="DeskAI keeps the last 50 checks and forgets older ones." />

                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.HasNoRecentChecks, Mode=OneWay}"
                                       Text="No checks yet. One will appear here after DeskAI looks." />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentChecks, Mode=OneWay}"
                                          AutomationProperties.Name="Recent checks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:CheckRunViewModel">
                                        <Border Style="{StaticResource RowCardStyle}">
                                            <StackPanel Spacing="3">
                                                <TextBlock FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                           Text="{x:Bind When}" />
                                                <TextBlock Style="{StaticResource CaptionStyle}"
                                                           TextWrapping="Wrap"
                                                           Text="{x:Bind What}" />
                                                <TextBlock Style="{StaticResource CaptionStyle}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{x:Bind HasNote}"
                                                           Foreground="{ThemeResource DeskCautionBrush}"
                                                           Text="{x:Bind Note}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Clear this history"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind ViewModel.HasRecentChecks, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ClearHistoryCommand}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="LeftColumn" Spacing="22">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Your rules" />
                            <controls:HelpButton Topic="automation.rules" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="560"
                                   HorizontalAlignment="Left"
                                   Text="{x:Bind ViewModel.Message, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Try a practice run"
                            Command="{x:Bind ViewModel.PractiseCommand}" />
                    <controls:HelpButton Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0"
                                         Topic="automation.practice" />
                </Grid>

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay}"
                              AutomationProperties.Name="Your rules">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:RuleViewModel">
                            <Border Style="{StaticResource RowCardStyle}">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                   Text="{x:Bind Name}" />
                                        <!--
                                            The rule read back as a sentence, built from the
                                            same objects that decide the behaviour, so what
                                            is shown cannot drift from what would happen.
                                        -->
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="{x:Bind Sentence}" />
                                    </StackPanel>
                                    <!-- On wears the accent because it is the person's confirmed choice; Off is plain. -->
                                    <Border Grid.Column="1" Style="{StaticResource AccentPillStyle}" Visibility="{x:Bind IsEnabled}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="11" Glyph="&#xE73E;" Foreground="{ThemeResource DeskAccentBrush}" />
                                            <TextBlock Style="{StaticResource PillTextStyle}" Text="{x:Bind State}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource PillStyle}" Visibility="{x:Bind IsOff}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="11" Glyph="&#xE711;" Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                                            <TextBlock Style="{StaticResource PillTextStyle}" Text="{x:Bind State}" />
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                            Content="{x:Bind ToggleAction}"
                                            Command="{Binding ElementName=Root, Path=ViewModel.ToggleRuleCommand}"
                                            CommandParameter="{x:Bind Id}" />
                                    <Button Grid.Column="3" VerticalAlignment="Center" Content="Delete"
                                            Command="{Binding ElementName=Root, Path=ViewModel.DeleteRuleCommand}"
                                            CommandParameter="{x:Bind Id}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasPractised, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="{x:Bind ViewModel.PracticeHeadline, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="{x:Bind ViewModel.PracticeDetail, Mode=OneWay}" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Proposals, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasProposals, Mode=OneWay}"
                              AutomationProperties.Name="What a practice run would move">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:RuleProposalViewModel">
                            <Border Style="{StaticResource RowCardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind File}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind Folder}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind Destination}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               Text="{x:Bind Reason}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Files two rules disagreed about. They are left alone on purpose, and the
                    page says so rather than hiding them.
                -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasConflicts, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Left alone" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Conflicts, Mode=OneWay}"
                                  AutomationProperties.Name="Files your rules disagreed about">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:RuleConflictViewModel">
                                <Border Style="{StaticResource RowCardStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource DeskCautionBrush}"
                                                   Text="{x:Bind File}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Text="{x:Bind Folder}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="{x:Bind Explanation}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Write a rule" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <!--
                            Say it in a sentence and DeskAI fills the boxes below. It fills
                            them and stops: understanding a sentence is not the same as
                            someone agreeing to what was understood, so the reading is always
                            shown in the form before it can become a rule.
                        -->
                        <TextBox Header="Say it in your own words, and DeskAI will fill in the boxes"
                                 PlaceholderText="move invoices to Documents"
                                 MaxLength="256"
                                 Text="{x:Bind ViewModel.Sentence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Read my sentence"
                                    Command="{x:Bind ViewModel.DraftFromSentenceCommand}" />
                            <controls:HelpButton Topic="automation.sentence" />
                        </StackPanel>

                        <Border Height="1" Margin="0,4" Background="{ThemeResource DeskLineBrush}" />

                        <TextBox Header="Name this rule" PlaceholderText="Tidy invoices"
                                 MaxLength="60"
                                 Text="{x:Bind ViewModel.NewRuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="When the name contains (optional)" PlaceholderText="invoice"
                                 MaxLength="120"
                                 Text="{x:Bind ViewModel.NewRuleNameContains, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="And the file ends with (optional)" PlaceholderText=".pdf"
                                 MaxLength="120"
                                 Text="{x:Bind ViewModel.NewRuleExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Move it into this folder" PlaceholderText="Documents\Invoices"
                                 Text="{x:Bind ViewModel.NewRuleDestination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                   Text="The folder is inside a folder you connected. Saving a rule changes nothing on its own." />
                        <Button Content="Save rule" HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.AddRuleCommand}" />
                        <!--
                            The answer to pressing Save belongs next to Save. This used to
                            appear beside the rule list further up the page, where someone
                            typing in this form never saw it, so a refused rule looked like
                            a button that did nothing.
                        -->
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"
                                   MaxWidth="560" HorizontalAlignment="Left"
                                   Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                   Visibility="{x:Bind ViewModel.HasFormMessage, Mode=OneWay}"
                                   Text="{x:Bind ViewModel.FormMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
