<Page
    x:Class="DeskAI.App.Views.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,40" MaxWidth="820" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Automatic tasks" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Text="Turn a cleanup you repeat into a rule DeskAI can run for you." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE7BA;"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock FontWeight="SemiBold" Text="Not built yet" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="Rules and schedules are planned but not implemented. To be completely clear: DeskAI is doing nothing in the background right now. It runs only while you have it open and only when you press a button." />
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon FontSize="15" Glyph="&#xE945;" VerticalAlignment="Top"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}"
                                       Text="Planned: describe a rule in your own words and review the exact version DeskAI understood before it is ever used." />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon FontSize="15" Glyph="&#xE7C1;" VerticalAlignment="Top"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}"
                                       Text="Planned: a practice run that shows what a rule would do, before it does anything." />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon FontSize="15" Glyph="&#xE72E;" VerticalAlignment="Top"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodySecondaryStyle}"
                                       Text="Planned: a pause-everything switch, and a history of every run you can look back through." />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
