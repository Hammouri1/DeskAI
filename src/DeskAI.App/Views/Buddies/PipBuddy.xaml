<?xml version="1.0" encoding="utf-8"?>
<!--
  Pip the robot, drawn from the approved mockup (characters.html, the "robot" card). Same rules as
  Sparky: a 200 x 200 drawing in a Viewbox, each moving part a full-size Canvas at 0,0 so its
  transform centre is in the mockup's coordinates. "Moods" poses with setters only; "Motion" runs
  the moves; "Still" runs none. Decorative: screen readers hear the buddy's line, not the drawing.
-->
<buddies:BuddyControl
    x:Class="DeskAI.App.Views.Buddies.PipBuddy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buddies="using:DeskAI.App.Views.Buddies"
    AutomationProperties.AccessibilityView="Raw">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Moods">
                <VisualState x:Name="Idle" />
                <VisualState x:Name="Thinking">
                    <VisualState.Setters>
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="ScreenDots.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Found">
                    <VisualState.Setters>
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthBig.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Nothing">
                    <VisualState.Setters>
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthFlat.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Happy">
                    <VisualState.Setters>
                        <Setter Target="Eyes.Visibility" Value="Collapsed" />
                        <Setter Target="HappyEyes.Visibility" Value="Visible" />
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthBig.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="Motion">
                <VisualState x:Name="IdleMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShadowTransform" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.72" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="JetTransform" Storyboard.TargetProperty="ScaleY" From="1" To="0.65" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="Forever" />
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AntennaLight" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="0.25" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChestSparkTransform" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1.15" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChestSparkTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1.15" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LensTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.2" Value="-14" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyesTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.05" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.23" Value="0.08" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="ThinkingMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="JetTransform" Storyboard.TargetProperty="ScaleY" From="1" To="0.5" Duration="0:0:0.09" AutoReverse="True" RepeatBehavior="Forever" />
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LensTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:0.6" Value="-14" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.2" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScreenDots" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.3" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="FoundMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="JetTransform" Storyboard.TargetProperty="ScaleY" From="1" To="0.65" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="Forever" />
                        <!-- The lens held up high: it found something. -->
                        <DoubleAnimation Storyboard.TargetName="LensTransform" Storyboard.TargetProperty="Rotation" To="-18" Duration="0:0:0.3" />
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChestSparkTransform" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1.25" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChestSparkTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1.25" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="NothingMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2" Value="-8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="JetTransform" Storyboard.TargetProperty="ScaleY" From="0.8" To="0.55" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="HappyMoving">
                    <Storyboard>
                        <!-- The screen face spins once. -->
                        <DoubleAnimation Storyboard.TargetName="ScreenTransform" Storyboard.TargetProperty="Rotation" From="0" To="360" Duration="0:0:0.9">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="JetTransform" Storyboard.TargetProperty="ScaleY" From="1.2" To="0.7" Duration="0:0:0.12" AutoReverse="True" RepeatBehavior="Forever" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Still" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Viewbox>
            <Canvas Width="200" Height="200">
                <Ellipse Canvas.Left="70" Canvas.Top="185" Width="60" Height="10" Fill="#000000" Opacity="0.3">
                    <Ellipse.RenderTransform>
                        <CompositeTransform x:Name="ShadowTransform" CenterX="30" CenterY="5" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Canvas x:Name="Body" Width="200" Height="200">
                    <Canvas.RenderTransform>
                        <CompositeTransform x:Name="BodyTransform" />
                    </Canvas.RenderTransform>

                    <Canvas x:Name="Jet" Width="200" Height="200">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="JetTransform" CenterX="100" CenterY="160" />
                        </Canvas.RenderTransform>
                        <Path Data="M88 160 Q100 198 112 160 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#FFF6B0" />
                                    <GradientStop Offset="0.5" Color="#FFB23F" />
                                    <GradientStop Offset="1" Color="#00FF5E3A" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Canvas>

                    <Line X1="100" Y1="38" X2="100" Y2="22" Stroke="#8A97A8" StrokeThickness="3" />
                    <Canvas x:Name="AntennaLight" Width="200" Height="200">
                        <Ellipse Canvas.Left="91" Canvas.Top="8" Width="18" Height="18" Fill="#5EF2C2" Opacity="0.35" />
                        <Ellipse Canvas.Left="94" Canvas.Top="11" Width="12" Height="12" Fill="#5EF2C2" />
                    </Canvas>
                    <Rectangle Canvas.Left="42" Canvas.Top="62" Width="12" Height="24" RadiusX="5" RadiusY="5" Fill="#8A97A8" />
                    <Rectangle Canvas.Left="146" Canvas.Top="62" Width="12" Height="24" RadiusX="5" RadiusY="5" Fill="#8A97A8" />
                    <Rectangle Canvas.Left="52" Canvas.Top="38" Width="96" Height="72" RadiusX="22" RadiusY="22" Stroke="#7D8B9C" StrokeThickness="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#F2F6FB" />
                                <GradientStop Offset="1" Color="#9FADBF" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Canvas x:Name="Screen" Width="200" Height="200">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="ScreenTransform" CenterX="100" CenterY="74" />
                        </Canvas.RenderTransform>
                        <Rectangle Canvas.Left="62" Canvas.Top="50" Width="76" Height="48" RadiusX="14" RadiusY="14">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#12324A" />
                                    <GradientStop Offset="1" Color="#071320" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas x:Name="Eyes" Width="200" Height="200">
                            <Canvas.RenderTransform>
                                <CompositeTransform x:Name="EyesTransform" CenterX="100" CenterY="71" />
                            </Canvas.RenderTransform>
                            <Rectangle Canvas.Left="78" Canvas.Top="62" Width="12" Height="18" RadiusX="6" RadiusY="6" Fill="#5EF2C2" />
                            <Rectangle Canvas.Left="110" Canvas.Top="62" Width="12" Height="18" RadiusX="6" RadiusY="6" Fill="#5EF2C2" />
                        </Canvas>
                        <Path x:Name="HappyEyes" Data="M78 74 Q84 64 90 74 M110 74 Q116 64 122 74" Stroke="#5EF2C2" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        <Path x:Name="Mouth" Data="M92 88 Q100 94 108 88" Stroke="#5EF2C2" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path x:Name="MouthBig" Data="M89 86 Q100 97 111 86" Stroke="#5EF2C2" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        <Path x:Name="MouthFlat" Data="M93 90 L107 90" Stroke="#5EF2C2" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        <Canvas x:Name="ScreenDots" Width="200" Height="200" Visibility="Collapsed">
                            <Ellipse Canvas.Left="87" Canvas.Top="86" Width="5" Height="5" Fill="#5EF2C2" />
                            <Ellipse Canvas.Left="97.5" Canvas.Top="86" Width="5" Height="5" Fill="#5EF2C2" />
                            <Ellipse Canvas.Left="108" Canvas.Top="86" Width="5" Height="5" Fill="#5EF2C2" />
                        </Canvas>
                        <Path Data="M68 57 Q80 52 94 54" Stroke="#4DFFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>

                    <Rectangle Canvas.Left="92" Canvas.Top="110" Width="16" Height="7" Fill="#8A97A8" />
                    <Rectangle Canvas.Left="66" Canvas.Top="116" Width="68" Height="46" RadiusX="16" RadiusY="16" Stroke="#7D8B9C" StrokeThickness="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#F2F6FB" />
                                <GradientStop Offset="1" Color="#9FADBF" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas x:Name="ChestSpark" Width="200" Height="200">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="ChestSparkTransform" CenterX="100" CenterY="139" />
                        </Canvas.RenderTransform>
                        <Path Data="M100 127 l3 9 9 3 -9 3 -3 9 -3 -9 -9 -3 9 -3z" Fill="#3FD9A8" />
                    </Canvas>
                    <Ellipse Canvas.Left="72" Canvas.Top="122" Width="4" Height="4" Fill="#7D8B9C" />
                    <Ellipse Canvas.Left="124" Canvas.Top="122" Width="4" Height="4" Fill="#7D8B9C" />
                    <Ellipse Canvas.Left="72" Canvas.Top="152" Width="4" Height="4" Fill="#7D8B9C" />
                    <Ellipse Canvas.Left="124" Canvas.Top="152" Width="4" Height="4" Fill="#7D8B9C" />
                    <Path Data="M66 128 Q50 136 52 150" Stroke="#B5C1D0" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Canvas.Left="46" Canvas.Top="147" Width="12" Height="12" Fill="#8A97A8" />

                    <Canvas x:Name="Lens" Width="200" Height="200">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="LensTransform" CenterX="134" CenterY="128" />
                        </Canvas.RenderTransform>
                        <Path Data="M134 128 Q150 122 156 106" Stroke="#B5C1D0" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="156" Y1="104" X2="161" Y2="97" Stroke="#E8B84A" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="155" Canvas.Top="73" Width="26" Height="26" Fill="#4DBFEFFF" Stroke="#E8B84A" StrokeThickness="4" />
                        <Path Data="M161 80 Q165 76 170 77" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</buddies:BuddyControl>
