<?xml version="1.0" encoding="utf-8"?>
<!--
  Paige the paper ghost, drawn from the approved mockup (characters.html, the "ghost" card). Same
  rules as Sparky: a 200 x 200 drawing in a Viewbox, each moving part a full-size Canvas at 0,0 so
  its transform centre is in the mockup's coordinates. "Moods" poses with setters only; "Motion"
  runs the moves; "Still" runs none. Decorative: screen readers hear the buddy's line, not the drawing.
-->
<buddies:BuddyControl
    x:Class="DeskAI.App.Views.Buddies.PaigeBuddy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buddies="using:DeskAI.App.Views.Buddies"
    AutomationProperties.AccessibilityView="Raw">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Moods">
                <VisualState x:Name="Idle" />
                <VisualState x:Name="Thinking">
                    <VisualState.Setters>
                        <!-- Eyes half-closed, thinking hard. -->
                        <Setter Target="HalfLids.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Found">
                    <VisualState.Setters>
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthBig.Visibility" Value="Visible" />
                        <Setter Target="ClipBright.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Nothing">
                    <VisualState.Setters>
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthFlat.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Happy">
                    <VisualState.Setters>
                        <Setter Target="Eyes.Visibility" Value="Collapsed" />
                        <Setter Target="HappyEyes.Visibility" Value="Visible" />
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthBig.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="Motion">
                <VisualState x:Name="IdleMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShadowTransform" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.72" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SheetTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.7" Value="7" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:3.4" Value="-7" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArmTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:0.8" Value="14" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.6" Value="-12" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle1" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.3" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.4" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.3" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.4" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyesTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.05" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.23" Value="0.08" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="ThinkingMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SheetTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:0.85" Value="7" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.7" Value="-7" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="FoundMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArmTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="14" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="-12" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.4" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0.4" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="NothingMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2" Value="-8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="HappyMoving">
                    <Storyboard>
                        <!-- A loop-the-loop. -->
                        <DoubleAnimation Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="Rotation" From="0" To="360" Duration="0:0:0.9">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Still" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Viewbox>
            <Canvas Width="200" Height="200">
                <Ellipse Canvas.Left="64" Canvas.Top="185" Width="72" Height="10" Fill="#000000" Opacity="0.3">
                    <Ellipse.RenderTransform>
                        <CompositeTransform x:Name="ShadowTransform" CenterX="36" CenterY="5" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Path x:Name="Twinkle1" Data="M34 50 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" Fill="#D8C8FF" Opacity="0.7" />
                <Path x:Name="Twinkle2" Data="M170 70 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" Fill="#D8C8FF" Opacity="0.7" />

                <Canvas x:Name="Body" Width="200" Height="200">
                    <Canvas.RenderTransform>
                        <CompositeTransform x:Name="BodyTransform" CenterX="100" CenterY="104" />
                    </Canvas.RenderTransform>
                    <Canvas x:Name="Sheet" Width="200" Height="200">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="SheetTransform" CenterX="100" CenterY="28" />
                        </Canvas.RenderTransform>

                        <Canvas x:Name="Arm" Width="200" Height="200">
                            <Canvas.RenderTransform>
                                <CompositeTransform x:Name="ArmTransform" CenterX="58" CenterY="112" />
                            </Canvas.RenderTransform>
                            <Path Data="M58 112 Q42 108 36 94" Stroke="#E8EEF6" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <Path Data="M142 112 Q156 118 160 130" Stroke="#E8EEF6" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                        <!-- The mockup's soft glow: a faint, slightly larger copy behind the paper. -->
                        <Path Data="M56 170 L56 82 Q56 38 100 38 Q144 38 144 82 L144 170 Q136 160 128 170 Q120 180 112 170 Q104 160 96 170 Q88 180 80 170 Q72 160 64 170 Q60 176 56 170 Z"
                              Fill="#FFFFFF" Opacity="0.2">
                            <Path.RenderTransform>
                                <CompositeTransform CenterX="100" CenterY="104" ScaleX="1.06" ScaleY="1.05" />
                            </Path.RenderTransform>
                        </Path>
                        <Path Data="M56 170 L56 82 Q56 38 100 38 Q144 38 144 82 L144 170 Q136 160 128 170 Q120 180 112 170 Q104 160 96 170 Q88 180 80 170 Q72 160 64 170 Q60 176 56 170 Z"
                              Stroke="#C7D1DE" StrokeThickness="2">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FFFFFF" />
                                    <GradientStop Offset="1" Color="#DDE5F0" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path Data="M58 122 H142 M58 136 H142 M58 150 H142 M58 164 H142" Stroke="#A9C7FF" StrokeThickness="1.5" Opacity="0.75" />
                        <Line X1="72" Y1="56" X2="72" Y2="170" Stroke="#FF9AA8" StrokeThickness="1.5" Opacity="0.75" />
                        <Path Data="M118 28 L118 58 Q118 65 124 65 Q130 65 130 58 L130 36 Q130 31 126 31 Q122 31 122 36 L122 55"
                              Stroke="#8D99A8" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path x:Name="ClipBright" Data="M118 28 L118 58 Q118 65 124 65 Q130 65 130 58 L130 36 Q130 31 126 31 Q122 31 122 36 L122 55"
                              Stroke="#3FD9A8" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />

                        <Canvas x:Name="Eyes" Width="200" Height="200">
                            <Canvas.RenderTransform>
                                <CompositeTransform x:Name="EyesTransform" CenterX="100" CenterY="88" />
                            </Canvas.RenderTransform>
                            <Ellipse Canvas.Left="80" Canvas.Top="79" Width="12" Height="18" Fill="#2A3446" />
                            <Ellipse Canvas.Left="85.7" Canvas.Top="81.7" Width="4.6" Height="4.6" Fill="#FFFFFF" />
                            <Ellipse Canvas.Left="108" Canvas.Top="79" Width="12" Height="18" Fill="#2A3446" />
                            <Ellipse Canvas.Left="113.7" Canvas.Top="81.7" Width="4.6" Height="4.6" Fill="#FFFFFF" />
                        </Canvas>
                        <!-- Thinking: paper-coloured lids over the top half of each eye. -->
                        <Canvas x:Name="HalfLids" Width="200" Height="200" Visibility="Collapsed">
                            <Rectangle Canvas.Left="79" Canvas.Top="77" Width="14" Height="11" Fill="#F4F7FB" />
                            <Rectangle Canvas.Left="107" Canvas.Top="77" Width="14" Height="11" Fill="#F4F7FB" />
                            <Path Data="M79 88 H93 M107 88 H121" Stroke="#2A3446" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <Path x:Name="HappyEyes" Data="M80 90 Q86 81 92 90 M108 90 Q114 81 120 90" Stroke="#2A3446" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        <Ellipse Canvas.Left="70" Canvas.Top="98.5" Width="12" Height="7" Fill="#FFB3C7" Opacity="0.8" />
                        <Ellipse Canvas.Left="118" Canvas.Top="98.5" Width="12" Height="7" Fill="#FFB3C7" Opacity="0.8" />

                        <Ellipse x:Name="Mouth" Canvas.Left="95" Canvas.Top="100" Width="10" Height="12" Fill="#2A3446" />
                        <Path x:Name="MouthBig" Data="M91 103 Q100 114 109 103" Stroke="#2A3446" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        <Path x:Name="MouthFlat" Data="M95 107 L105 107" Stroke="#2A3446" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    </Canvas>
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</buddies:BuddyControl>
