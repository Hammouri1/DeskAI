<?xml version="1.0" encoding="utf-8"?>
<!--
  Archie the owl, drawn from the approved mockup (characters.html, the "owl" card). Same rules as
  Sparky: a 200 x 200 drawing in a Viewbox, each moving part a full-size Canvas at 0,0 so its
  transform centre is in the mockup's coordinates. "Moods" poses with setters only; "Motion" runs
  the moves; "Still" runs none. Decorative: screen readers hear the buddy's line, not the drawing.
-->
<buddies:BuddyControl
    x:Class="DeskAI.App.Views.Buddies.ArchieBuddy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buddies="using:DeskAI.App.Views.Buddies"
    AutomationProperties.AccessibilityView="Raw">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Moods">
                <VisualState x:Name="Idle" />
                <VisualState x:Name="Thinking">
                    <VisualState.Setters>
                        <Setter Target="ThinkDots.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Found">
                    <VisualState.Setters>
                        <Setter Target="Sparkles.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Nothing">
                    <VisualState.Setters>
                        <Setter Target="SleepyLids.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Happy">
                    <VisualState.Setters>
                        <Setter Target="Eyes.Visibility" Value="Collapsed" />
                        <Setter Target="HappyEyes.Visibility" Value="Visible" />
                        <Setter Target="Sparkles.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="Motion">
                <VisualState x:Name="IdleMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShadowTransform" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.72" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftWingTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:0.95" Value="16" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.9" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightWingTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:0.95" Value="-16" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.9" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyesTransform" Storyboard.TargetProperty="TranslateX" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.75" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.25" Value="3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:3" Value="3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="-3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.25" Value="-3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:5" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyesTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.05" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.23" Value="0.08" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TiltTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.65" Value="-6" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:3.3" Value="4" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:5.5" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="ThinkingMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <!-- The eyes dart while it looks. -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyesTransform" Storyboard.TargetProperty="TranslateX" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="-3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="-3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThinkDots" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.3" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="FoundMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightWingTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:0.6" Value="-20" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.2" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sparkles" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.4" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="NothingMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2" Value="-8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="HappyMoving">
                    <Storyboard>
                        <!-- Both wings flap fast, three times. -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftWingTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="3x">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="24" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightWingTransform" Storyboard.TargetProperty="Rotation" RepeatBehavior="3x">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="-24" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="-16" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Still" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Viewbox>
            <Canvas Width="200" Height="200">
                <Ellipse Canvas.Left="60" Canvas.Top="182" Width="80" Height="12" Fill="#000000" Opacity="0.3">
                    <Ellipse.RenderTransform>
                        <CompositeTransform x:Name="ShadowTransform" CenterX="40" CenterY="6" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Canvas x:Name="Body" Width="200" Height="200">
                    <Canvas.RenderTransform>
                        <CompositeTransform x:Name="BodyTransform" />
                    </Canvas.RenderTransform>
                    <Canvas x:Name="Tilt" Width="200" Height="200">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="TiltTransform" CenterX="100" CenterY="183" />
                        </Canvas.RenderTransform>

                        <Canvas x:Name="LeftWing" Width="200" Height="200">
                            <Canvas.RenderTransform>
                                <CompositeTransform x:Name="LeftWingTransform" CenterX="64" CenterY="100" />
                            </Canvas.RenderTransform>
                            <Path Data="M54 100 Q28 128 44 164 Q60 152 64 118 Z" Fill="#6B4630" />
                        </Canvas>
                        <Canvas x:Name="RightWing" Width="200" Height="200">
                            <Canvas.RenderTransform>
                                <CompositeTransform x:Name="RightWingTransform" CenterX="136" CenterY="100" />
                            </Canvas.RenderTransform>
                            <Path Data="M146 100 Q172 128 156 164 Q140 152 136 118 Z" Fill="#6B4630" />
                        </Canvas>

                        <Ellipse Canvas.Left="50" Canvas.Top="64" Width="100" Height="112">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#9A6844" />
                                    <GradientStop Offset="1" Color="#5B3A25" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Path Data="M62 74 L56 42 L82 64 Z" Fill="#5B3A25" />
                        <Path Data="M138 74 L144 42 L118 64 Z" Fill="#5B3A25" />
                        <Ellipse Canvas.Left="68" Canvas.Top="103" Width="64" Height="70">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#F7E6CB" />
                                    <GradientStop Offset="1" Color="#E0C49C" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Path Data="M84 130 q4 5 8 0 M96 130 q4 5 8 0 M108 130 q4 5 8 0 M90 144 q4 5 8 0 M102 144 q4 5 8 0 M96 158 q4 5 8 0"
                              Stroke="#C9A57A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="56" Canvas.Top="61" Width="88" Height="62" Fill="#7A5036" />
                        <Ellipse Canvas.Left="64" Canvas.Top="76" Width="32" Height="32" Fill="#FFF8E8" />
                        <Ellipse Canvas.Left="104" Canvas.Top="76" Width="32" Height="32" Fill="#FFF8E8" />

                        <Canvas x:Name="Eyes" Width="200" Height="200">
                            <Canvas.RenderTransform>
                                <CompositeTransform x:Name="EyesTransform" CenterX="100" CenterY="93" />
                            </Canvas.RenderTransform>
                            <Ellipse Canvas.Left="73.5" Canvas.Top="85.5" Width="15" Height="15" Fill="#1D1208" />
                            <Ellipse Canvas.Left="81.5" Canvas.Top="87.5" Width="5" Height="5" Fill="#FFFFFF" />
                            <Ellipse Canvas.Left="113.5" Canvas.Top="85.5" Width="15" Height="15" Fill="#1D1208" />
                            <Ellipse Canvas.Left="121.5" Canvas.Top="87.5" Width="5" Height="5" Fill="#FFFFFF" />
                        </Canvas>
                        <Path x:Name="HappyEyes" Data="M72 95 Q80 85 88 95 M112 95 Q120 85 128 95" Stroke="#1D1208" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        <!-- Nothing: drowsy lids over the top half of each eye. The colours stay the same. -->
                        <Path x:Name="SleepyLids" Data="M64 92 A16 16 0 0 1 96 92 Z M104 92 A16 16 0 0 1 136 92 Z" Fill="#7A5036" Visibility="Collapsed" />

                        <Ellipse Canvas.Left="62" Canvas.Top="74" Width="36" Height="36" Stroke="#E8B84A" StrokeThickness="3.5" />
                        <Ellipse Canvas.Left="102" Canvas.Top="74" Width="36" Height="36" Stroke="#E8B84A" StrokeThickness="3.5" />
                        <Path Data="M98 90 Q100 86 102 90" Stroke="#E8B84A" StrokeThickness="3" />
                        <Path Data="M94 106 L106 106 L100 117 Z" Fill="#F2A33A" />
                        <Path Data="M84 174 l-4 8 M89 175 l0 8 M94 174 l4 8 M106 174 l-4 8 M111 175 l0 8 M116 174 l4 8"
                              Stroke="#F2A33A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                        <Canvas x:Name="FileCard" Width="200" Height="200">
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="-10" CenterX="134" CenterY="150" />
                            </Canvas.RenderTransform>
                            <Rectangle Canvas.Left="120" Canvas.Top="138" Width="32" Height="24" RadiusX="3" RadiusY="3" Fill="#FFFDF6" Stroke="#D6CBB5" />
                            <Path Data="M125 145 h22 M125 150 h17 M125 155 h12" Stroke="#9AA7B5" StrokeThickness="2" />
                            <Rectangle Canvas.Left="120" Canvas.Top="138" Width="32" Height="5" RadiusX="2" RadiusY="2" Fill="#3FD9A8" />
                        </Canvas>
                        <Ellipse Canvas.Left="115" Canvas.Top="154" Width="18" Height="12" Fill="#6B4630" />

                        <Canvas x:Name="Sparkles" Width="200" Height="200" Visibility="Collapsed">
                            <Path Data="M160 126 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" Fill="#FFF6A8" />
                            <Path Data="M168 146 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5z" Fill="#BFFFEA" />
                        </Canvas>
                        <Canvas x:Name="ThinkDots" Width="200" Height="200" Visibility="Collapsed">
                            <Ellipse Canvas.Left="148" Canvas.Top="44" Width="7" Height="7" Fill="#FFF8E8" />
                            <Ellipse Canvas.Left="160" Canvas.Top="34" Width="9" Height="9" Fill="#FFF8E8" />
                            <Ellipse Canvas.Left="174" Canvas.Top="22" Width="11" Height="11" Fill="#FFF8E8" />
                        </Canvas>
                    </Canvas>
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</buddies:BuddyControl>
