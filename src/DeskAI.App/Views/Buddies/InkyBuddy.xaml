<?xml version="1.0" encoding="utf-8"?>
<!--
  Inky the octopus, drawn from the approved mockup (characters.html, the "octopus" card). Same
  rules as Sparky: a 200 x 200 drawing in a Viewbox, each moving part a full-size Canvas at 0,0 so
  its transform centre is in the mockup's coordinates. "Moods" poses with setters only; "Motion"
  runs the moves; "Still" runs none. Decorative: screen readers hear the buddy's line, not the drawing.
-->
<buddies:BuddyControl
    x:Class="DeskAI.App.Views.Buddies.InkyBuddy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buddies="using:DeskAI.App.Views.Buddies"
    AutomationProperties.AccessibilityView="Raw">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Moods">
                <VisualState x:Name="Idle" />
                <VisualState x:Name="Thinking">
                    <VisualState.Setters>
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthO.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Found">
                    <VisualState.Setters>
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthBig.Visibility" Value="Visible" />
                        <Setter Target="Sparkles.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Nothing">
                    <VisualState.Setters>
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthFlat.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Happy">
                    <VisualState.Setters>
                        <Setter Target="LeftEye.Visibility" Value="Collapsed" />
                        <Setter Target="WinkEye.Visibility" Value="Collapsed" />
                        <Setter Target="HappyEyes.Visibility" Value="Visible" />
                        <Setter Target="Mouth.Visibility" Value="Collapsed" />
                        <Setter Target="MouthBig.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="Motion">
                <VisualState x:Name="IdleMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShadowTransform" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.72" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm1Transform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.1" Value="8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.2" Value="-8" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm2Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:0.5" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.1" Value="8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.2" Value="-8" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm3Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:1" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.1" Value="8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.2" Value="-8" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm4Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:1.5" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.1" Value="8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.2" Value="-8" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bubble1Transform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.42,0,1,1" KeyTime="0:0:3.2" Value="-70" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bubble1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.64" Value="0.8" />
                            <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bubble2Transform" Storyboard.TargetProperty="TranslateY" BeginTime="0:0:1.2" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.42,0,1,1" KeyTime="0:0:3.2" Value="-70" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bubble2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.2" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.64" Value="0.8" />
                            <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bubble3Transform" Storyboard.TargetProperty="TranslateY" BeginTime="0:0:2.1" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.42,0,1,1" KeyTime="0:0:3.2" Value="-70" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bubble3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:2.1" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.64" Value="0.8" />
                            <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEyeTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.05" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.23" Value="0.08" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WinkEyeTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.68" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:4.92" Value="0.08" />
                            <LinearDoubleKeyFrame KeyTime="0:0:5.28" Value="0.08" />
                            <LinearDoubleKeyFrame KeyTime="0:0:6" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="ThinkingMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <!-- The arms reach about, faster, while it looks. -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm1Transform" Storyboard.TargetProperty="Rotation" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="-12" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm2Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:0.25" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="-12" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm3Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:0.5" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="-12" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm4Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:0.75" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="12" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="-12" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="FoundMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:1.4" Value="-12" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2.8" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sparkles" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.4" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="NothingMoving">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTransform" Storyboard.TargetProperty="TranslateY" RepeatBehavior="Forever">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:2" Value="-8" />
                            <SplineDoubleKeyFrame KeySpline="0.45,0,0.55,1" KeyTime="0:0:4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="HappyMoving">
                    <Storyboard>
                        <!-- Every arm waves once, one after another. -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm1Transform" Storyboard.TargetProperty="Rotation">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="-20" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm2Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:0.1">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="-20" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm3Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:0.2">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="20" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arm4Transform" Storyboard.TargetProperty="Rotation" BeginTime="0:0:0.3">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="20" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Still" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Viewbox>
            <Canvas Width="200" Height="200">
                <Ellipse x:Name="Bubble1" Canvas.Left="32" Canvas.Top="166" Width="8" Height="8" Stroke="#9FD4FF" StrokeThickness="1.5" Opacity="0">
                    <Ellipse.RenderTransform><CompositeTransform x:Name="Bubble1Transform" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Bubble2" Canvas.Left="162" Canvas.Top="170" Width="12" Height="12" Stroke="#9FD4FF" StrokeThickness="1.5" Opacity="0">
                    <Ellipse.RenderTransform><CompositeTransform x:Name="Bubble2Transform" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Bubble3" Canvas.Left="147" Canvas.Top="165" Width="6" Height="6" Stroke="#9FD4FF" StrokeThickness="1.5" Opacity="0">
                    <Ellipse.RenderTransform><CompositeTransform x:Name="Bubble3Transform" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="56" Canvas.Top="185" Width="88" Height="10" Fill="#000000" Opacity="0.3">
                    <Ellipse.RenderTransform>
                        <CompositeTransform x:Name="ShadowTransform" CenterX="44" CenterY="5" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Canvas x:Name="Body" Width="200" Height="200">
                    <Canvas.RenderTransform>
                        <CompositeTransform x:Name="BodyTransform" />
                    </Canvas.RenderTransform>

                    <Path Data="M70 116 Q46 136 38 160" Stroke="#8A58EE" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Canvas x:Name="Arm1" Width="200" Height="200">
                        <Canvas.RenderTransform><CompositeTransform x:Name="Arm1Transform" CenterX="80" CenterY="120" /></Canvas.RenderTransform>
                        <Path Data="M84 120 Q70 150 76 176" Stroke="#8A58EE" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    <Canvas x:Name="Arm2" Width="200" Height="200">
                        <Canvas.RenderTransform><CompositeTransform x:Name="Arm2Transform" CenterX="92" CenterY="122" /></Canvas.RenderTransform>
                        <Path Data="M96 122 Q94 154 88 178" Stroke="#7D4BE4" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    <Canvas x:Name="Arm3" Width="200" Height="200">
                        <Canvas.RenderTransform><CompositeTransform x:Name="Arm3Transform" CenterX="110" CenterY="122" /></Canvas.RenderTransform>
                        <Path Data="M106 122 Q110 154 114 178" Stroke="#7D4BE4" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    <Canvas x:Name="Arm4" Width="200" Height="200">
                        <Canvas.RenderTransform><CompositeTransform x:Name="Arm4Transform" CenterX="122" CenterY="120" /></Canvas.RenderTransform>
                        <Path Data="M118 120 Q132 150 126 176" Stroke="#8A58EE" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    <Path Data="M130 116 Q154 136 162 158" Stroke="#8A58EE" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                    <!-- A photo in one arm and a PDF in another. -->
                    <Rectangle Canvas.Left="18" Canvas.Top="146" Width="28" Height="24" RadiusX="3" RadiusY="3" Fill="#FFFFFF" />
                    <Path Data="M21 166 L29 156 L34 161 L39 155 L44 166 Z" Fill="#3FD9A8" />
                    <Ellipse Canvas.Left="36.4" Canvas.Top="148.4" Width="5.2" Height="5.2" Fill="#F7C65C" />
                    <Rectangle Canvas.Left="154" Canvas.Top="138" Width="24" Height="30" RadiusX="3" RadiusY="3" Fill="#FFFFFF" />
                    <Rectangle Canvas.Left="154" Canvas.Top="138" Width="24" Height="10" RadiusX="3" RadiusY="3" Fill="#FF5E5E" />
                    <TextBlock Canvas.Left="154" Canvas.Top="137.5" Width="24" FontSize="7.5" FontWeight="Bold" Foreground="#FFFFFF" Text="PDF" TextAlignment="Center" />
                    <Path Data="M158 154 h16 M158 159 h12 M158 164 h14" Stroke="#B9C2CC" StrokeThickness="1.5" />

                    <Path Data="M52 92 Q52 38 100 36 Q148 38 148 92 Q148 126 100 128 Q52 126 52 92 Z">
                        <Path.Fill>
                            <RadialGradientBrush Center="0.4,0.35" GradientOrigin="0.4,0.35" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop Offset="0" Color="#D9B0FF" />
                                <GradientStop Offset="1" Color="#7040D6" />
                            </RadialGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Ellipse Canvas.Left="69" Canvas.Top="55" Width="10" Height="10" Fill="#E8D0FF" Opacity="0.6" />
                    <Ellipse Canvas.Left="124" Canvas.Top="52" Width="8" Height="8" Fill="#E8D0FF" Opacity="0.6" />
                    <Ellipse Canvas.Left="133" Canvas.Top="73" Width="6" Height="6" Fill="#E8D0FF" Opacity="0.6" />
                    <Path Data="M68 52 Q80 42 94 42" Stroke="#FFFFFF" StrokeThickness="4" Opacity="0.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                    <Canvas x:Name="LeftEye" Width="200" Height="200">
                        <Canvas.RenderTransform><CompositeTransform x:Name="LeftEyeTransform" CenterX="84" CenterY="90" /></Canvas.RenderTransform>
                        <Ellipse Canvas.Left="73" Canvas.Top="79" Width="22" Height="22" Fill="#FFFFFF" />
                        <Ellipse Canvas.Left="80" Canvas.Top="86" Width="12" Height="12" Fill="#23123F" />
                        <Ellipse Canvas.Left="86" Canvas.Top="87" Width="4" Height="4" Fill="#FFFFFF" />
                    </Canvas>
                    <Canvas x:Name="WinkEye" Width="200" Height="200">
                        <Canvas.RenderTransform><CompositeTransform x:Name="WinkEyeTransform" CenterX="116" CenterY="90" /></Canvas.RenderTransform>
                        <Ellipse Canvas.Left="105" Canvas.Top="79" Width="22" Height="22" Fill="#FFFFFF" />
                        <Ellipse Canvas.Left="112" Canvas.Top="86" Width="12" Height="12" Fill="#23123F" />
                        <Ellipse Canvas.Left="118" Canvas.Top="87" Width="4" Height="4" Fill="#FFFFFF" />
                    </Canvas>
                    <Path x:Name="HappyEyes" Data="M75 93 Q84 81 93 93 M107 93 Q116 81 125 93" Stroke="#23123F" StrokeThickness="3.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    <Ellipse Canvas.Left="66" Canvas.Top="102.5" Width="12" Height="7" Fill="#FF9FCF" Opacity="0.7" />
                    <Ellipse Canvas.Left="122" Canvas.Top="102.5" Width="12" Height="7" Fill="#FF9FCF" Opacity="0.7" />

                    <Path x:Name="Mouth" Data="M93 108 Q100 114 107 108" Stroke="#23123F" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path x:Name="MouthBig" Data="M91 106 Q100 118 109 106" Stroke="#23123F" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    <Ellipse x:Name="MouthO" Canvas.Left="96.5" Canvas.Top="106" Width="7" Height="8" Fill="#23123F" Visibility="Collapsed" />
                    <Path x:Name="MouthFlat" Data="M94 110 L106 110" Stroke="#23123F" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />

                    <Canvas x:Name="Sparkles" Width="200" Height="200" Visibility="Collapsed">
                        <Path Data="M50 136 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" Fill="#FFF6A8" />
                        <Path Data="M184 128 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" Fill="#BFFFEA" />
                    </Canvas>
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</buddies:BuddyControl>
