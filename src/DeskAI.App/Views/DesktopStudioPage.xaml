<Page
    x:Class="DeskAI.App.Views.DesktopStudioPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:DeskAI.App.ViewModels"
    xmlns:controls="using:DeskAI.App.Controls"
    Background="{ThemeResource DeskGroundBrush}">
    <Page.Resources>
        <x:Double x:Key="BoardColumnWidth">300</x:Double>
        <!-- About eight rows: enough to see what a group is about without the board running off the screen. -->
        <x:Double x:Key="GroupCardHeight">372</x:Double>
        <x:Double x:Key="NotSureMaxHeight">340</x:Double>
        <x:Double x:Key="NotSureItemWidth">300</x:Double>

        <Style x:Key="BoardIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Quiet so a column of them does not shout; it still reads as a button on hover and focus. -->
        <Style x:Key="MoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource DeskTextSecondaryBrush}" />
        </Style>

        <DataTemplate x:Key="BoardItemTemplate" x:DataType="viewmodels:DesktopItemViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="2,1,4,1" Margin="0,0,8,0">
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind Name}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource MoveButtonStyle}" Content="Move to…"
                        Tag="{x:Bind Path}" Click="OnMoveClick" />
            </Grid>
        </DataTemplate>

        <x:Double x:Key="MoveListMaxHeight">320</x:Double>

        <DataTemplate x:Key="MoveItemTemplate" x:DataType="viewmodels:DesktopMoveItemViewModel">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Padding="0,2">
                <CheckBox IsChecked="{x:Bind IsTicked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Top"
                          AutomationProperties.Name="{x:Bind Name}" />
                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="14" Margin="0,8,0,0" VerticalAlignment="Top"
                          Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                <StackPanel Grid.Column="2" Margin="0,5,0,0">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Warning}" TextWrapping="Wrap"
                               Visibility="{x:Bind HasWarning}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LeftAloneTemplate">
            <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Margin="32,28,32,40" MaxWidth="1320" HorizontalAlignment="Left" Spacing="22">

            <Border Style="{StaticResource PageIntroStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource PageTitleStyle}"
                                   Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                   Text="Desktop Studio" />
                        <controls:HelpButton Topic="studio.groups" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock MaxWidth="560" TextWrapping="Wrap"
                               Foreground="{ThemeResource DeskTextSecondaryBrush}"
                               Text="Make your Desktop easier to find your way around. Each card does one job, and nothing changes until you choose." />
                </StackPanel>
            </Border>

            <!-- Shown only until the Desktop is connected: the same dialog as the Your folders card. -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsDesktopNotConnected, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connect your Desktop first" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"
                               Text="DeskAI needs to see the names of the folders and files on your Desktop. It reads nothing inside them and moves nothing." />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="Connect Desktop" Click="OnConnectClick" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsDesktopConnected, Mode=OneWay}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="1. Find groups" />
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"
                                   Text="DeskAI sorts the folders and files on your Desktop into groups. Nothing on your PC changes." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind ViewModel.SendButtonText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasAi, Mode=OneWay}"
                                Click="OnFindWithAiClick" />
                        <Button Content="Use DeskAI's guess"
                                Click="OnGuessClick" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                 AutomationProperties.Name="Working" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasBoard, Mode=OneWay}">
                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.SourceNote, Mode=OneWay}" />
                <!-- Every card is the same size so the board reads as a tidy grid; a long group scrolls inside its card. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" AutomationProperties.Name="Groups">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:DesktopGroupViewModel">
                            <Border Style="{StaticResource RowCardStyle}" Width="{StaticResource BoardColumnWidth}"
                                    Height="{StaticResource GroupCardHeight}" Margin="0,0,12,12" Padding="14,12,8,12">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="2,0,0,0">
                                        <StackPanel Spacing="0">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Name}"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind CountText}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource BoardIconButtonStyle}"
                                                Tag="{x:Bind Name}" Click="OnGroupOptionsClick"
                                                AutomationProperties.Name="Rename or merge"
                                                ToolTipService.ToolTip="Rename or merge">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                        <ItemsControl ItemsSource="{x:Bind Items}" AutomationProperties.Name="{x:Bind Name}"
                                                      ItemTemplate="{StaticResource BoardItemTemplate}" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Not sure is often the biggest list, so it takes the full width and flows into columns. -->
                <Border Style="{StaticResource RowCardStyle}" Margin="0,0,12,0" Padding="14,12,8,12"
                        Visibility="{x:Bind ViewModel.HasNotSure, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Not sure" VerticalAlignment="Bottom" />
                            <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                       Text="{x:Bind ViewModel.NotSureCountText, Mode=OneWay}" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="{StaticResource NotSureMaxHeight}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.NotSure}" AutomationProperties.Name="Not sure"
                                          ItemTemplate="{StaticResource BoardItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapGrid Orientation="Horizontal" ItemWidth="{StaticResource NotSureItemWidth}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- A change that stopped part-way is asked about before anything else moves. -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasInterrupted, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Your last change stopped part-way" />
                    <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.InterruptedText, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Keep them where they are" Visibility="{x:Bind ViewModel.CanKeepInterrupted, Mode=OneWay}"
                                Click="OnKeepInterruptedClick" />
                        <Button Content="Put them back" Visibility="{x:Bind ViewModel.CanPutBackInterrupted, Mode=OneWay}"
                                Click="OnPutBackInterruptedClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsDesktopConnected, Mode=OneWay}">
                <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.CannotMoveThings, Mode=OneWay}"
                           Text="The cards below move things on your Desktop. DeskAI asks before the first move, and Put back returns your latest change." />
                <HyperlinkButton Content="Stop DeskAI moving things on my Desktop" Padding="0"
                                 Visibility="{x:Bind ViewModel.CanMoveThings, Mode=OneWay}" Click="OnStopMovingClick" />
                <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                           Text="{x:Bind ViewModel.MovesMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasMovesMessage, Mode=OneWay}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasBoard, Mode=OneWay}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="2. Happy with these groups?" />
                            <controls:HelpButton Topic="studio.folderByGroup" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"
                                   Text="DeskAI can make a folder for each group on your Desktop and put the group's things inside. You see the list first, and Not sure stays where it is." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Put each group in its own folder" Tag="FolderByGroup" Click="OnPreviewClick" />
                        <Button Style="{StaticResource AccentButtonStyle}" Tag="FolderByGroup" Click="OnApplyClick"
                                Content="{x:Bind ViewModel.FolderByGroup.ApplyButtonText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.FolderByGroup.HasPreview, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.FolderByGroup.CanApply, Mode=OneWay}" />
                        <Button Content="Put back" Tag="FolderByGroup" Click="OnPutBackClick"
                                Visibility="{x:Bind ViewModel.FolderByGroup.CanPutBack, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.FolderByGroup.LastText, Mode=OneWay}" Visibility="{x:Bind ViewModel.FolderByGroup.CanPutBack, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.FolderByGroup.Message, Mode=OneWay}" Visibility="{x:Bind ViewModel.FolderByGroup.HasMessage, Mode=OneWay}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.FolderByGroup.HasPreview, Mode=OneWay}">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.FolderByGroup.TotalText, Mode=OneWay}" />
                        <ScrollViewer MaxHeight="{StaticResource MoveListMaxHeight}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FolderByGroup.Items}" AutomationProperties.Name="Group things that would move"
                                          ItemTemplate="{StaticResource MoveItemTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.FolderByGroup.HasLeftAlone, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Text="Left where they are" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FolderByGroup.LeftAlone}" AutomationProperties.Name="Group things left where they are"
                                      ItemTemplate="{StaticResource LeftAloneTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Other tidy-ups" Margin="0,12,0,0"
                       Visibility="{x:Bind ViewModel.IsDesktopConnected, Mode=OneWay}" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsDesktopConnected, Mode=OneWay}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Clear old stuff" />
                            <controls:HelpButton Topic="studio.oldStuff" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"
                                   Text="Folders and files you haven't changed in 6 months go into one Old stuff folder on your Desktop. Nothing is deleted." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Show what would move" Tag="OldStuff" Click="OnPreviewClick" />
                        <Button Style="{StaticResource AccentButtonStyle}" Tag="OldStuff" Click="OnApplyClick"
                                Content="{x:Bind ViewModel.OldStuff.ApplyButtonText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.OldStuff.HasPreview, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.OldStuff.CanApply, Mode=OneWay}" />
                        <Button Content="Put back" Tag="OldStuff" Click="OnPutBackClick"
                                Visibility="{x:Bind ViewModel.OldStuff.CanPutBack, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.OldStuff.LastText, Mode=OneWay}" Visibility="{x:Bind ViewModel.OldStuff.CanPutBack, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.OldStuff.Message, Mode=OneWay}" Visibility="{x:Bind ViewModel.OldStuff.HasMessage, Mode=OneWay}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.OldStuff.HasPreview, Mode=OneWay}">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.OldStuff.TotalText, Mode=OneWay}" />
                        <ScrollViewer MaxHeight="{StaticResource MoveListMaxHeight}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.OldStuff.Items}" AutomationProperties.Name="Old things that would move"
                                          ItemTemplate="{StaticResource MoveItemTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.OldStuff.HasLeftAlone, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Text="Left where they are" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OldStuff.LeftAlone}" AutomationProperties.Name="Old things left where they are"
                                      ItemTemplate="{StaticResource LeftAloneTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
