<Page
    x:Class="DeskAI.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource DeskGroundBrush}">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,44" MaxWidth="920" HorizontalAlignment="Left" Spacing="24">

            <!--
                The status readout replaces the old welcome banner. It states the current
                scope first, because "what can this app touch right now" is the single fact
                a person most needs on opening a file organizer. The green rail carries that
                meaning; it is the same signal used everywhere else for an approved state.
            -->
            <Border Style="{StaticResource HeroPanelStyle}">
                <StackPanel Spacing="12" MaxWidth="620" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{ThemeResource DeskAccentBrush}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DeskAccentBrush}"
                                   Text="Practice mode" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource DeskDisplayStyle}"
                               Text="Your files are untouched" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="DeskAI is working with sample files only. No folder of yours is connected, so nothing on your computer can be moved, renamed, or deleted." />
                </StackPanel>
            </Border>

            <!--
                One panel divided by hairlines rather than three separate cards. The numbers
                belong to the same reading, so they share one surface.
            -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                    <StackPanel Padding="20,18" Spacing="6">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Folders connected" />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="0" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="DeskAI reads nothing until you pick one." />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="0,16"
                            Background="{ThemeResource DeskLineBrush}" />

                    <StackPanel Grid.Column="2" Padding="20,18" Spacing="6">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="AI help" />
                        <TextBlock Style="{StaticResource MetricStyle}" Text="Off" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Turn it on with your own key any time." />
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Margin="0,16"
                            Background="{ThemeResource DeskLineBrush}" />

                    <StackPanel Grid.Column="4" Padding="20,18" Spacing="6">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Search" />
                        <TextBlock Style="{StaticResource MetricStyle}"
                                   Foreground="{ThemeResource DeskCautionBrush}"
                                   Text="Not ready" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Still being built." />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="What you can try now" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Style="{StaticResource StepBadgeStyle}" VerticalAlignment="Top">
                                <FontIcon FontSize="14" Glyph="&#xE8B7;"
                                          Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                           Text="Practice organizing" />
                                <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="600"
                                           HorizontalAlignment="Left"
                                           Text="Open Organize to see suggested moves for safe sample files, run them, and undo them. Your own files are never used here." />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Style="{StaticResource StepBadgeStyle}" VerticalAlignment="Top">
                                <FontIcon FontSize="14" Glyph="&#xE8A5;"
                                          Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                           Text="Look inside a folder, safely" />
                                <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="600"
                                           HorizontalAlignment="Left"
                                           Text="Connect a folder for a read-only preview. DeskAI lists names, sizes, and dates. It cannot move, rename, delete, or open what is inside." />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Style="{StaticResource StepBadgeStyle}" VerticalAlignment="Top">
                                <FontIcon FontSize="14" Glyph="&#xE753;"
                                          Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                           Text="Add your own AI key, if you want one" />
                                <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="600"
                                           HorizontalAlignment="Left"
                                           Text="Privacy and AI lets you use a service you already pay for. AI only ever suggests. It can never move or change a file." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
                The safety chain is spelled out because it genuinely is a sequence, which is
                the only reason a stepped treatment is used anywhere in this design.
            -->
            <Border Style="{StaticResource SoftCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" FontSize="13"
                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                               Text="How DeskAI keeps you in control" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="Scan, suggest, check, preview, you approve, run, undo. AI can recommend, but only DeskAI's own code decides what is allowed, and only after you approve it." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
