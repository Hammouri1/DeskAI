<Page
    x:Class="DeskAI.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:DeskAI.App.ViewModels"
    Background="{ThemeResource DeskGroundBrush}">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,44" MaxWidth="920" HorizontalAlignment="Left" Spacing="24">

            <StackPanel Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Search" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Text="Find files by name, type, size, or date. Searching never moves, renames, or opens anything." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="PhraseBox"
                                 MaxLength="256"
                                 PlaceholderText="photos from last month"
                                 Text="{x:Bind ViewModel.Phrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnPhraseKeyDown"
                                 AutomationProperties.Name="What are you looking for" />
                        <Button Grid.Column="1"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Search"
                                Command="{x:Bind ViewModel.SearchCommand}" />
                    </Grid>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="620"
                                   HorizontalAlignment="Left"
                                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>

                    <!--
                        How the phrase was read, shown before the results. Interpretation is
                        visible on purpose: a search that silently decides what someone meant
                        is worse than one that shows its reading.
                    -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasChips, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="DeskAI read this as" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Chips, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border CornerRadius="3" Padding="10,5"
                                            Background="{ThemeResource DeskAccentSoftBrush}"
                                            BorderBrush="{ThemeResource DeskAccentBrush}"
                                            BorderThickness="1">
                                        <TextBlock FontSize="12"
                                                   Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                   Text="{x:Bind}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Visibility="{x:Bind ViewModel.HasScopeMessage, Mode=OneWay}"
                               Text="{x:Bind ViewModel.ScopeMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                          AutomationProperties.Name="Search results">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SearchResultViewModel">
                        <Border Style="{StaticResource RowCardStyle}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind Location}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{x:Bind Size}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="88"
                                           TextAlignment="Right"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{x:Bind Changed}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource SoftCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" FontSize="13"
                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                               Text="What search can and cannot do" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="It looks only inside folders you connected, and only at names, sizes, and dates that DeskAI remembered — never the contents of your files. Disconnecting a folder immediately forgets everything remembered about it." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
