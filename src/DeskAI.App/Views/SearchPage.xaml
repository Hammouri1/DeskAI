<Page
    x:Class="DeskAI.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,40" MaxWidth="820" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Search" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Text="Find files by name, type, size, or date — without moving anything." />
            </StackPanel>

            <!--
                A truthful empty state. The controls below are deliberately disabled rather
                than hidden, so the page shows where search is going without pretending it
                works yet.
            -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE7BA;"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock FontWeight="SemiBold" Text="Not finished yet" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="DeskAI can now remember file details for a folder you connect, but the search screen that uses it is still being built. Nothing here works yet, and nothing is being searched." />
                    <AutoSuggestBox IsEnabled="False" PlaceholderText="Search your connected folders"
                                    QueryIcon="Find"
                                    AutomationProperties.Name="Search box, not available yet" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button IsEnabled="False" Content="File type" />
                        <Button IsEnabled="False" Content="Size" />
                        <Button IsEnabled="False" Content="Date changed" />
                        <Button IsEnabled="False" Content="Folder" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <FontIcon FontSize="18" Glyph="&#xE946;" VerticalAlignment="Top"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="What search will and will not do" />
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   Text="It will only ever look inside folders you have connected, and it reads names, sizes, and dates — never the contents of your files. Disconnecting a folder immediately forgets everything remembered about it." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
