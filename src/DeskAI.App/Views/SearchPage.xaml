<Page
    x:Class="DeskAI.App.Views.SearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:DeskAI.App.ViewModels"
    xmlns:controls="using:DeskAI.App.Controls"
    Background="{ThemeResource DeskGroundBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Style="{StaticResource PageContentStyle}">

            <Border Style="{StaticResource PageIntroStyle}"><StackPanel Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Search" />
                    <controls:HelpButton Topic="search.searching" />
                </StackPanel>
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Text="Find files by name or details. With your permission, search words inside notes, Word, and Excel files too. Searching never changes a file." />
            </StackPanel></Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Look in" VerticalAlignment="Center"
                                   Style="{StaticResource BodySecondaryStyle}" />
                        <ComboBox MinWidth="220" MaxWidth="340"
                                  ItemsSource="{x:Bind ViewModel.SearchFolders, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.Name="Folder to search" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="12">
                        <TextBox x:Name="PhraseBox"
                                 MaxLength="256"
                                 PlaceholderText="Try: Word document containing space"
                                 Text="{x:Bind ViewModel.Phrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnPhraseKeyDown"
                                 AutomationProperties.Name="What are you looking for" />
                        <!--
                            Deliberately not an accent button. The accent means "safe or
                            confirmed", and searching confirms nothing, so wearing that
                            colour here would dilute the one signal the app relies on.
                        -->
                        <Button Grid.Column="1"
                                Content="Search"
                                Command="{x:Bind ViewModel.SearchCommand}" />
                        <!--
                            Only while AI is set up. It sends the typed words alone, after a dialog,
                            and the AI's reading lands in the box as a plain search to check.
                        -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                                    Visibility="{x:Bind ViewModel.HasAi, Mode=OneWay}">
                            <Button Content="{x:Bind ViewModel.AskAiText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanAskAi, Mode=OneWay}"
                                    Click="OnAskAiClick" />
                            <controls:HelpButton Topic="search.askAi" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Visibility="{x:Bind ViewModel.HasAiMessage, Mode=OneWay}"
                               Text="{x:Bind ViewModel.AiMessage, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Search scanned PDF words"
                                IsEnabled="{x:Bind ViewModel.CanSearchScannedPdfs, Mode=OneWay}"
                                Click="OnSearchScannedPdfsClick" />
                        <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                   Text="Local OCR · approximate · PDF permission required" />
                    </StackPanel>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="620"
                                   HorizontalAlignment="Left"
                                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>

                    <!--
                        How the phrase was read, shown before the results. Interpretation is
                        visible on purpose: a search that silently decides what someone meant
                        is worse than one that shows its reading.
                    -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasChips, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="DeskAI read this as" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Chips, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <!-- A reading of the phrase, not a permission, so the chip is a plain pill. -->
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource PillStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="11" Glyph="&#xE71C;"
                                                      Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                                            <TextBlock Style="{StaticResource PillTextStyle}" Text="{x:Bind}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Visibility="{x:Bind ViewModel.HasScopeMessage, Mode=OneWay}"
                               Text="{x:Bind ViewModel.ScopeMessage, Mode=OneWay}" />

                    <Button Content="Save this search"
                            Click="OnSaveSearchClick"
                            IsEnabled="{x:Bind ViewModel.CanSaveCurrentSearch, Mode=OneWay}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!--
                Saved searches are virtual. Running one searches again from scratch against
                whatever is connected now; nothing about a saved search moves a file, and
                none of them records a folder, so one cannot outlive an authorization.
            -->


            <ItemsControl ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                          AutomationProperties.Name="Search results">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SearchResultViewModel">
                        <Border Style="{StaticResource RowCardStyle}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind Location}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{x:Bind Size}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="88"
                                           TextAlignment="Right"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{x:Bind Changed}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                What was found inside files. Only appears when a folder has allowed reading,
                and always states how many files were actually opened, so "nothing matched"
                is never mistaken for "nothing exists".
            -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsInsideFiles, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Found inside your files" />
                        <controls:HelpButton Topic="search.readInside" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="{x:Bind ViewModel.InsideMessage, Mode=OneWay}" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.InsideResults, Mode=OneWay}"
                              AutomationProperties.Name="Files matched by their contents">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ContentHitViewModel">
                            <Border Style="{StaticResource RowCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind Location}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind Snippet}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="Files checked"
                          Visibility="{x:Bind ViewModel.HasCheckedFiles, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CheckedFiles, Mode=OneWay}"
                                  AutomationProperties.Name="Files checked for content matches">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ContentCheckViewModel">
                                <Border Style="{StaticResource RowCardStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind Name}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind Location}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                                   Text="{x:Bind Result}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsVisualResults, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Found in pictures" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"
                           Text="{x:Bind ViewModel.VisualMessage, Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.VisualResults, Mode=OneWay}"
                              AutomationProperties.Name="Files matched by picture contents">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ContentHitViewModel">
                            <Border Style="{StaticResource RowCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Location}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                               Text="{x:Bind Snippet}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.HasSavedSearches, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Saved searches" />
                            <controls:HelpButton Topic="search.saved" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="600"
                                   HorizontalAlignment="Left"
                                   Text="These are searches, not folders. Running one looks again in whatever folders are connected at the time. Nothing is moved or changed." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.SavedSearches, Mode=OneWay}"
                                  AutomationProperties.Name="Saved searches">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SavedSearchViewModel">
                                <Border Style="{StaticResource RowCardStyle}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.ColumnSpan="3" Spacing="3">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                       Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{x:Bind Phrase}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="Run"
                                                Command="{Binding ElementName=Root, Path=ViewModel.RunSavedSearchCommand}"
                                                CommandParameter="{x:Bind Id}" />
                                        <Button Grid.Column="2" VerticalAlignment="Center" Content="Remove"
                                                Command="{Binding ElementName=Root, Path=ViewModel.DeleteSavedSearchCommand}"
                                                CommandParameter="{x:Bind Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
<!--
                Folder management sits on this page because scope is part of searching:
                what DeskAI can find is exactly what you connected, and nothing else.
            -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Folders DeskAI can search" />
                                <controls:HelpButton Topic="search.connect" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Text="{x:Bind ViewModel.FolderMessage, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" MaxWidth="560"
                                       HorizontalAlignment="Left" TextWrapping="Wrap"
                                       Text="Choose Desktop, Downloads, Documents, Pictures, or a folder inside one of them." />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Connect a folder"
                                Click="OnConnectFolderClick"
                                IsEnabled="{x:Bind ViewModel.IsFolderIdle, Mode=OneWay}" />
                    </Grid>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsFolderBusy, Mode=OneWay}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay}"
                                  AutomationProperties.Name="Connected folders">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ConnectedFolderViewModel">
                                <Border Style="{StaticResource RowCardStyle}">
                                    <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                       Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{x:Bind Path}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="{x:Bind Remembered}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasLookNote}"
                                                       Text="{x:Bind LookNote}" />
                                            <!--
                                                The permission is written on the row, not left
                                                implicit in a button label. A permission a
                                                person cannot see is one they cannot reconsider.
                                                The pill wears the accent only when reading inside
                                                is allowed, because that is a permission.
                                            -->
                                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                                <Border Style="{StaticResource AccentPillStyle}" Visibility="{x:Bind CanReadContent}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="11" Glyph="&#xE8A5;" Foreground="{ThemeResource DeskAccentBrush}" />
                                                        <TextBlock Style="{StaticResource PillTextStyle}" Text="Can read inside" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PillStyle}" Visibility="{x:Bind IsNamesOnly}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="11" Glyph="&#xE8A5;" Foreground="{ThemeResource DeskTextSecondaryBrush}" />
                                                        <TextBlock Style="{StaticResource PillTextStyle}" Text="Names, sizes, dates" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                                           Text="{x:Bind ContentState}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button VerticalAlignment="Center"
                                                        Content="{x:Bind ContentAction}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnContentPermissionClick" />
                                                <Button VerticalAlignment="Center"
                                                        Content="Read Word and Excel too"
                                                        Visibility="{x:Bind CanUpgradeDocuments}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnDocumentsPermissionClick" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Visibility="{x:Bind CanReadDocuments}">
                                                <Button VerticalAlignment="Center"
                                                        Content="Read PDF text too"
                                                        Visibility="{x:Bind CanUpgradePdf}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnPdfPermissionClick" />
                                                <Button VerticalAlignment="Center"
                                                        Content="Stop PDF reading"
                                                        Visibility="{x:Bind CanReadPdf}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnPdfPermissionClick" />
                                                <Button VerticalAlignment="Center"
                                                        Content="Read PowerPoint text too"
                                                        Visibility="{x:Bind CanUpgradeSlides}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnSlidesPermissionClick" />
                                                <Button VerticalAlignment="Center"
                                                        Content="Stop PowerPoint reading"
                                                        Visibility="{x:Bind CanReadSlides}"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnSlidesPermissionClick" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Content="Refresh"
                                                Command="{Binding ElementName=Root, Path=ViewModel.RefreshFolderCommand}"
                                                CommandParameter="{x:Bind Id}" />
                                        <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Disconnect"
                                                Command="{Binding ElementName=Root, Path=ViewModel.DisconnectFolderCommand}"
                                                CommandParameter="{x:Bind Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Expander Header="How search protects your files" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                   Text="What search can and cannot do" />
                        <controls:HelpButton Topic="search.readInside" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="It looks only in folders you connected. Normally it uses names, sizes, and dates. You can separately allow notes, Word and Excel, PDF text, and PowerPoint slide text. Pictures in pages or slides and programs stay closed. Words read from a file are not saved or sent to AI. Disconnecting forgets the folder." />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
