<Page
    x:Class="DeskAI.App.Views.SearchPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:DeskAI.App.ViewModels"
    Background="{ThemeResource DeskGroundBrush}">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,44" MaxWidth="920" HorizontalAlignment="Left" Spacing="24">

            <StackPanel Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Search" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Text="Find files by name, type, size, or date. Searching never moves, renames, or opens anything." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="PhraseBox"
                                 MaxLength="256"
                                 PlaceholderText="photos from last month"
                                 Text="{x:Bind ViewModel.Phrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnPhraseKeyDown"
                                 AutomationProperties.Name="What are you looking for" />
                        <!--
                            Deliberately not an accent button. The accent means "safe or
                            confirmed", and searching confirms nothing, so wearing that
                            colour here would dilute the one signal the app relies on.
                        -->
                        <Button Grid.Column="1"
                                Content="Search"
                                Command="{x:Bind ViewModel.SearchCommand}" />
                    </Grid>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="620"
                                   HorizontalAlignment="Left"
                                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>

                    <!--
                        How the phrase was read, shown before the results. Interpretation is
                        visible on purpose: a search that silently decides what someone meant
                        is worse than one that shows its reading.
                    -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasChips, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="DeskAI read this as" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Chips, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border CornerRadius="3" Padding="10,5"
                                            Background="{ThemeResource DeskAccentSoftBrush}"
                                            BorderBrush="{ThemeResource DeskAccentBrush}"
                                            BorderThickness="1">
                                        <TextBlock FontSize="12"
                                                   Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                   Text="{x:Bind}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Visibility="{x:Bind ViewModel.HasScopeMessage, Mode=OneWay}"
                               Text="{x:Bind ViewModel.ScopeMessage, Mode=OneWay}" />

                    <Button Content="Save this search"
                            Click="OnSaveSearchClick"
                            IsEnabled="{x:Bind ViewModel.CanSaveCurrentSearch, Mode=OneWay}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!--
                Saved searches are virtual. Running one searches again from scratch against
                whatever is connected now; nothing about a saved search moves a file, and
                none of them records a folder, so one cannot outlive an authorization.
            -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.HasSavedSearches, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Saved searches" />
                        <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="600"
                                   HorizontalAlignment="Left"
                                   Text="These are searches, not folders. Running one looks again in whatever folders are connected at the time. Nothing is moved or changed." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.SavedSearches, Mode=OneWay}"
                                  AutomationProperties.Name="Saved searches">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SavedSearchViewModel">
                                <Border Style="{StaticResource RowCardStyle}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                       Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{x:Bind Phrase}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="Run"
                                                Command="{Binding ElementName=Root, Path=ViewModel.RunSavedSearchCommand}"
                                                CommandParameter="{x:Bind Id}" />
                                        <Button Grid.Column="2" VerticalAlignment="Center" Content="Remove"
                                                Command="{Binding ElementName=Root, Path=ViewModel.DeleteSavedSearchCommand}"
                                                CommandParameter="{x:Bind Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                          AutomationProperties.Name="Search results">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SearchResultViewModel">
                        <Border Style="{StaticResource RowCardStyle}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind Location}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{x:Bind Size}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="88"
                                           TextAlignment="Right"
                                           Style="{StaticResource CaptionStyle}"
                                           Text="{x:Bind Changed}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                What was found inside files. Only appears when a folder has allowed reading,
                and always states how many files were actually opened, so "nothing matched"
                is never mistaken for "nothing exists".
            -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsInsideFiles, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Found inside your files" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="{x:Bind ViewModel.InsideMessage, Mode=OneWay}" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.InsideResults, Mode=OneWay}"
                              AutomationProperties.Name="Files matched by their contents">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ContentHitViewModel">
                            <Border Style="{StaticResource RowCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind Location}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                               Text="{x:Bind Snippet}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--
                Folder management sits on this page because scope is part of searching:
                what DeskAI can find is exactly what you connected, and nothing else.
            -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Folders DeskAI can search" />
                            <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Text="{x:Bind ViewModel.FolderMessage, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Connect a folder"
                                Click="OnConnectFolderClick"
                                IsEnabled="{x:Bind ViewModel.IsFolderIdle, Mode=OneWay}" />
                    </Grid>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsFolderBusy, Mode=OneWay}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay}"
                                  AutomationProperties.Name="Connected folders">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ConnectedFolderViewModel">
                                <Border Style="{StaticResource RowCardStyle}">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource DeskTextPrimaryBrush}"
                                                       Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{x:Bind Path}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="{x:Bind Remembered}" />
                                            <!--
                                                The permission is written on the row, not left
                                                implicit in a button label. A permission a
                                                person cannot see is one they cannot reconsider.
                                            -->
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="{x:Bind ContentState}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center"
                                                Content="{x:Bind ContentAction}"
                                                Tag="{x:Bind Id}"
                                                Click="OnContentPermissionClick" />
                                        <Button Grid.Column="2" VerticalAlignment="Center" Content="Refresh"
                                                Command="{Binding ElementName=Root, Path=ViewModel.RefreshFolderCommand}"
                                                CommandParameter="{x:Bind Id}" />
                                        <Button Grid.Column="3" VerticalAlignment="Center" Content="Disconnect"
                                                Command="{Binding ElementName=Root, Path=ViewModel.DisconnectFolderCommand}"
                                                CommandParameter="{x:Bind Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" FontSize="13"
                               Foreground="{ThemeResource DeskTextPrimaryBrush}"
                               Text="What search can and cannot do" />
                    <TextBlock Style="{StaticResource BodySecondaryStyle}" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="It looks only inside folders you connected. Normally it uses just the names, sizes, and dates it remembered. If you allow it for a folder, it can also read the beginning of plain text files there to find words written inside — never PDFs, photos, or programs, and nothing it reads is saved or sent anywhere. Disconnecting a folder immediately forgets everything remembered about it." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
